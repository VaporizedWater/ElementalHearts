	VitalSoilItem: {
		DisplayName: Vital Soil
		Tooltip:
			'''
			Faintly glowing, life-aspected silt
			Spreads slowly to nearby Dirt, Mud, and Silt
			Can be crushed in the Extractinator
			Standing on it boosts life regeneration
			'''
	}

	VitalQuartzItem: {
		DisplayName: Vital Quartz
		Tooltip:
			'''
			Living stone shot through with peach and lime green
			Spreads slowly to nearby Stone
			Can be crushed in the Extractinator
			Grants extra maximum life while you are nearby
			'''
	}

