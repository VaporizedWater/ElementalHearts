# Every top-level key is auto-prefixed with "Mods.ElementalHearts." by tModLoader,
# so `Common.HpGain` below resolves at runtime as `Mods.ElementalHearts.Common.HpGain`.
#
# Heart display names that aren't listed here are auto-generated from the class name
# on first build (CamelCase splits into spaced words). Only override an entry when
# the auto-generated form would be wrong — missing apostrophe, lowercase "of"/"the"/
# "and", or a vanilla-name correction.
#
# ElementalPower (optional per heart) overrides the curated name from ElementalPowerRegistry.

Common: {
	HpGain: Permanently increases maximum life by {0}
	ElementalPowerActivated: The elemental power of the {0} has been activated
}

Configs: {
	ElementalHeartsConfig: {
		DisplayName: Heart HP Values

		Common: {
			Label: Common Heart HP
			Tooltip: HP granted by every Common-tier heart. Default 2.
		}

		Uncommon: {
			Label: Uncommon Heart HP
			Tooltip: HP granted by every Uncommon-tier heart. Default 4.
		}

		Rare: {
			Label: Rare Heart HP
			Tooltip: HP granted by every Rare-tier heart. Default 6.
		}

		Epic: {
			Label: Epic Heart HP
			Tooltip: HP granted by every Epic-tier heart. Default 8.
		}

		Legendary: {
			Label: Legendary Heart HP
			Tooltip: HP granted by every Legendary-tier heart. Default 10.
		}

		Exotic: {
			Label: Exotic Heart HP
			Tooltip: HP granted by every Exotic boss-themed heart. Default 10.
		}

		Mythic: {
			Label: Mythic Heart HP
			Tooltip: HP granted by the Zenith Heart. Default 50.
		}

		Headers: {
			HeartHPGains: Heart H P Gains Header
			RecipeSettings: Recipe Settings Header
			BossSettings: Boss Settings Header
		}

		RecipeDifficulty: {
			Label: Recipe Difficulty
			Tooltip: ""
		}

		BossHeartsGuaranteedOnFirstKill: {
			Label: Boss Hearts Guaranteed On First Kill
			Tooltip: ""
		}

		BossHeartRNG: {
			Label: Boss Heart R N G
			Tooltip: ""
		}
	}

	ElementalHeartsBossConfig: {
		DisplayName: Boss Drop Settings

		BossHeartsGuaranteedOnFirstKill: {
			Label: Boss Hearts Guaranteed On First Kill
			Tooltip: If enabled, defeating a boss for the very first time will guarantee its specific heart drops.
		}

		BossHeartRNG: {
			Label: Boss Heart Drop Chance (%)
			Tooltip: The percentage chance for a boss to drop its heart on subsequent kills. Default: 10%.
		}
	}

	ElementalHeartsHPConfig: {
		DisplayName: Heart HP Values

		Common: {
			Label: Common Heart HP
			Tooltip: HP granted by every Common-tier heart. Default: 2.
		}

		Uncommon: {
			Label: Uncommon Heart HP
			Tooltip: HP granted by every Uncommon-tier heart. Default: 4.
		}

		Rare: {
			Label: Rare Heart HP
			Tooltip: HP granted by every Rare-tier heart. Default: 6.
		}

		Epic: {
			Label: Epic Heart HP
			Tooltip: HP granted by every Epic-tier heart. Default: 8.
		}

		Legendary: {
			Label: Legendary Heart HP
			Tooltip: HP granted by every Legendary-tier heart. Default: 10.
		}

		Exotic: {
			Label: Exotic Heart HP
			Tooltip: HP granted by every Exotic boss-themed heart. Default: 10.
		}

		Mythic: {
			Label: Mythic Heart HP
			Tooltip: HP granted by the Zenith Heart. Default: 50.
		}
	}

	ElementalHeartsRecipeConfig: {
		DisplayName: Recipe Settings

		RecipeDifficulty: {
			Label: Recipe Difficulty
			Tooltip: Scales the required crafting materials for all hearts. 10 is default (1x multiplier). 5 is half-cost. 20 is double-cost.
		}
	}

	ElementalHeartsVisualConfig: {
		DisplayName: Visual Settings

		ConsumptionEffectStrength: {
			Label: Consumption Effect Strength
			Tooltip: Scales the intensity of the visual and physical effects when consuming a heart. 3 is default.
		}
	}

	ElementalHeartsWorldConfig: {
		DisplayName: World Registry

		ClearHeartRegistry: {
			Label: Clear Consumed Heart Registry
			Tooltip: Toggle to reset the world! Clears all activated hearts so you can consume them again. Just press this once and it will clear.
		}
	}
}

