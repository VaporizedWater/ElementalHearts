# Every top-level key is auto-prefixed with "Mods.ElementalHearts." by tModLoader,
# so `Common.HpGain` below resolves at runtime as `Mods.ElementalHearts.Common.HpGain`.
#
# Heart display names that aren't listed here are auto-generated from the class name
# on first build (CamelCase splits into spaced words). Only override an entry when
# the auto-generated form would be wrong — missing apostrophe, lowercase "of"/"the"/
# "and", or a vanilla-name correction.
#
# ElementalPower (optional per heart) overrides the curated name from ElementalPowerRegistry.

Common: {
	HpGain: Permanently increases maximum life by {0}
	ElementalPowerActivated: The elemental power of the {0} has been activated
}

Configs: {
	ElementalHeartsBossConfig: {
		DisplayName: Boss Drop Settings
		Headers.Drops: Boss Heart Drops

		BossHeartsGuaranteedOnFirstKill: {
			Label: Guaranteed On First Kill
			Tooltip:
				'''
				If enabled, the very first time you defeat a boss it will always drop its themed heart.
				The drop chance below only applies on subsequent kills.
				'''
		}

		BossHeartDropChance: {
			Label: Boss Heart Drop Chance (%)
			Tooltip: Percentage chance for a boss to drop its themed heart on each kill after the first.
		}
	}

	ElementalHeartsCrossModConfig: {
		DisplayName: Cross-Mod Settings
		Headers.SupportedMods: Supported Mods

		EnableCalamityHearts: {
			Label: Enable Calamity Hearts
			Tooltip:
				'''
				Load hearts themed around Calamity Mod content.
				Disabling removes them entirely — they can't be crafted, dropped, or found.
				Requires a reload.
				'''
		}

		EnableThoriumHearts: {
			Label: Enable Thorium Hearts
			Tooltip:
				'''
				Load hearts themed around Thorium Mod content.
				Disabling removes them entirely — they can't be crafted, dropped, or found.
				Requires a reload.
				'''
		}

		EnableConsolariaHearts: {
			Label: Enable Consolaria Hearts
			Tooltip:
				'''
				Load hearts themed around Consolaria content.
				Disabling removes them entirely — they can't be crafted, dropped, or found.
				Requires a reload.
				'''
		}
	}

	ElementalHeartsHPConfig: {
		DisplayName: HP Settings

		Headers: {
			Challenge: Challenge Mode
			CraftableTiers: Craftable Heart Tiers
			BossTiers: Boss Heart Tiers
		}

		ChallengeMode: {
			Label: Challenge Mode
			Tooltip:
				'''
				Hardcore health rules. Your max life starts at 1 and Life Crystals give only 5 (down from 20),
				so hearts become your real path to a bigger health bar. To compensate, every heart grants
				double its configured HP. Disabled by default.
				'''
		}

		Common: {
			Label: Common Heart HP
			Tooltip: Maximum life each Common-tier heart grants when consumed. Default 2.
		}

		Uncommon: {
			Label: Uncommon Heart HP
			Tooltip: Maximum life each Uncommon-tier heart grants when consumed. Default 4.
		}

		Rare: {
			Label: Rare Heart HP
			Tooltip: Maximum life each Rare-tier heart grants when consumed. Default 6.
		}

		Epic: {
			Label: Epic Heart HP
			Tooltip: Maximum life each Epic-tier heart grants when consumed. Default 8.
		}

		Legendary: {
			Label: Legendary Heart HP
			Tooltip: Maximum life each Legendary-tier heart grants when consumed. Default 10.
		}

		Exotic: {
			Label: Exotic Heart HP
			Tooltip: Maximum life each Exotic-tier (vanilla boss) heart grants when consumed. Default 10.
		}

		Mythic: {
			Label: Mythic Heart HP
			Tooltip: Maximum life each Mythic-tier (Animate final-boss) heart grants when consumed. Default 50.
		}
	}

	ElementalHeartsRecipeConfig: {
		DisplayName: Recipe Settings
		Headers.Crafting: Crafting Difficulty

		RecipeDifficulty: {
			Label: Recipe Difficulty (x0.1 cost)
			Tooltip:
				'''
				Scales the materials every heart recipe needs.
				10 is the default (1x cost); 5 is half cost, 20 is double.
				Requires a reload.
				'''
		}
	}

	ElementalHeartsVisualConfig: {
		DisplayName: Visual Settings

		Headers: {
			Effects: Consumption Effect
			UI: Heads-Up Display
		}

		ConsumptionEffectStrength: {
			Label: Consumption Effect Strength
			Tooltip:
				'''
				Scales the particles, screen shake, and lighting of the heart-consumption effect.
				1 is subtle, 3 is the default, 5 is dramatic.
				'''
		}

		DraggableUI: {
			Label: Draggable Life Shard UI
			Tooltip:
				'''
				When enabled, the Life Shard panel can be clicked and dragged to any screen position.
				The new position is saved automatically to UI Position below.
				'''
		}

		UIPosition: {
			Label: Life Shard UI Position
			Tooltip:
				'''
				Saved screen coordinates of the Life Shard panel. Only used while Draggable UI is enabled.
				Set both to 0 to fall back to the default location.
				'''
		}
	}

	ElementalHeartsPotionEffectConfig: {
		DisplayName: Potion Heart Settings
		Headers.PotionHearts: Potion Hearts

		WorldwidePotionEffectsEnabled: {
			Label: Enable World-Wide Potion Effects
			Tooltip:
				'''
				When on, consuming a Potion Heart keeps that potion's buff permanently active
				on every player in the world. When off, Potion Hearts only grant their HP boost
				and behave like any other elemental heart.
				'''
		}
	}

	ElementalHeartsTipsConfig: {
		DisplayName: Tips Settings
		Headers.Tips: In-Game Tips

		EnableTips: {
			Label: Enable Tips
			Tooltip:
				'''
				When enabled, helpful in-game tips appear on the Life Shard UI (e.g. the Animate
				progression hint). Turn off to hide all tip badges.
				'''
		}
	}

	ElementalHeartsWorldConfig: {
		DisplayName: World Settings

		Headers: {
			ResetActions: Reset Actions (one-shot)
			Worldgen: Mini-Biome Generation
			NightEvents: Night Events Header
			Progression: Progression Header
			Cheats: Cheats Header
		}

		ClearHeartRegistry: {
			Label: Clear Consumed Hearts
			Tooltip:
				'''
				Enable to wipe this world's consumed-heart record and refund the max life it granted,
				so every heart can be consumed again. Resets itself once it runs.
				'''
		}

		ClearElementalTier: {
			Label: Clear Elemental Tier
			Tooltip:
				'''
				Enable to reset the Animate progression tier in this world back to the starting tier.
				Resets itself once it runs.
				'''
		}

		GenerateLifeBiomes: {
			Label: Generate Life Mini-Biomes
			Tooltip:
				'''
				When on, new worlds generate Vital Soil patches on the surface and heart-shaped
				Vital Quartz formations in the jungle. Only affects fresh worlds.
				'''
		}

		SurfaceBiomeCountMultiplier: {
			Label: Surface Biome Count Multiplier
			Tooltip:
				'''
				Multiplies the surface Vital Soil biome count. 1 is the default (~3 on small,
				~5 on medium, ~7 on large worlds). Set to 0 to disable surface biomes only.
				'''
		}

		JungleBiomeCountMultiplier: {
			Label: Jungle Biome Count Multiplier
			Tooltip: Multiplies the jungle Vital Quartz biome count. 1 is the default (~3 on small, ~4 on medium, ~6 on large worlds). Set to 0 to disable jungle biomes only.
		}

		HeartShootingStarMaxPerNight: {
			Tooltip: ""
			Label: Heart Shooting Star Max Per Night
		}

		HeartShootingStarChance: {
			Tooltip: ""
			Label: Heart Shooting Star Chance
		}

		HeartShootingStarFrequency: {
			Label: Heart Shooting Star Frequency
			Tooltip: ""
		}

		SharedProgression: {
			Label: Shared Progression
			Tooltip: ""
		}

		AdminMode: {
			Label: Admin Mode
			Tooltip: ""
		}
	}

	LifeShardConfig: {
		DisplayName: Life Shard Settings

		Headers: {
			General: General
			DropChances: Damage-Based Drop Chances
			DamageThresholds: Damage Thresholds
			Extractinator: Extractinator Yields
			Consumable: Consumable Shards
		}

		SystemEnabled: {
			Label: Enable Life Shard System
			Tooltip: Master switch for the entire Life Shard system — both damage-based drops and all shard crafting. Turn this off to disable it completely.
		}

		CommonDropChance: {
			Label: Common Shard Drop Chance (%)
			Tooltip: Chance to drop a Common Life Shard the first time an enemy's cumulative damage reaches the Common threshold. Bosses roll at double this chance.
		}

		UncommonDropChance: {
			Label: Uncommon Shard Drop Chance (%)
			Tooltip: Chance to drop an Uncommon Life Shard the first time an enemy's cumulative damage reaches the Uncommon threshold. Bosses roll at double this chance.
		}

		RareDropChance: {
			Label: Rare Shard Drop Chance (%)
			Tooltip: Chance to drop a Rare Life Shard the first time an enemy's cumulative damage reaches the Rare threshold. Bosses roll at double this chance.
		}

		EpicDropChance: {
			Label: Epic Shard Drop Chance (%)
			Tooltip: Chance to drop an Epic Life Shard the first time an enemy's cumulative damage reaches the Epic threshold. Bosses roll at double this chance.
		}

		LegendaryDropChance: {
			Label: Legendary Shard Drop Chance (%)
			Tooltip: Chance to drop a Legendary Life Shard the first time an enemy's cumulative damage reaches the Legendary threshold. Bosses roll at double this chance.
		}

		CommonDamageThreshold: {
			Label: Common Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for a Common Life Shard.
		}

		UncommonDamageThreshold: {
			Label: Uncommon Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for an Uncommon Life Shard.
		}

		RareDamageThreshold: {
			Label: Rare Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for a Rare Life Shard.
		}

		EpicDamageThreshold: {
			Label: Epic Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for an Epic Life Shard.
		}

		LegendaryDamageThreshold: {
			Label: Legendary Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for a Legendary Life Shard.
		}

		ExtractinatorCommonMin: {
			Label: Extractinator Common Minimum
			Tooltip: Fewest Common Life Shards a Life Crystal yields in the Extractinator.
		}

		ExtractinatorCommonMax: {
			Label: Extractinator Common Maximum
			Tooltip: Most Common Life Shards a Life Crystal yields in the Extractinator.
		}

		ExtractinatorUncommonChance: {
			Label: Extractinator Uncommon Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Uncommon Life Shards.
		}

		ExtractinatorUncommonMin: {
			Label: Extractinator Uncommon Minimum
			Tooltip: Fewest Uncommon Life Shards yielded when the Uncommon bonus roll succeeds.
		}

		ExtractinatorUncommonMax: {
			Label: Extractinator Uncommon Maximum
			Tooltip: Most Uncommon Life Shards yielded when the Uncommon bonus roll succeeds.
		}

		ExtractinatorRareChance: {
			Label: Extractinator Rare Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Rare Life Shards.
		}

		ExtractinatorRareMin: {
			Label: Extractinator Rare Minimum
			Tooltip: Fewest Rare Life Shards yielded when the Rare bonus roll succeeds.
		}

		ExtractinatorRareMax: {
			Label: Extractinator Rare Maximum
			Tooltip: Most Rare Life Shards yielded when the Rare bonus roll succeeds.
		}

		ExtractinatorEpicChance: {
			Label: Extractinator Epic Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Epic Life Shards.
		}

		ExtractinatorEpicMin: {
			Label: Extractinator Epic Minimum
			Tooltip: Fewest Epic Life Shards yielded when the Epic bonus roll succeeds.
		}

		ExtractinatorEpicMax: {
			Label: Extractinator Epic Maximum
			Tooltip: Most Epic Life Shards yielded when the Epic bonus roll succeeds.
		}

		ExtractinatorLegendaryChance: {
			Label: Extractinator Legendary Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Legendary Life Shards.
		}

		ExtractinatorLegendaryMin: {
			Label: Extractinator Legendary Minimum
			Tooltip: Fewest Legendary Life Shards yielded when the Legendary bonus roll succeeds.
		}

		ExtractinatorLegendaryMax: {
			Label: Extractinator Legendary Maximum
			Tooltip: Most Legendary Life Shards yielded when the Legendary bonus roll succeeds.
		}

		ShardsAreConsumable: {
			Label: Shards Are Consumable
			Tooltip: When on, Life Shards held in the regular inventory can be used as quick-heal items. Shards inside the Life Shard panel are never consumed.
		}

		ShardSicknessSeconds: {
			Label: Shard Sickness Duration (seconds)
			Tooltip: Seconds of Shard Sickness applied after consuming a Life Shard. Independent of Potion Sickness from healing potions.
		}

		CommonHealAmount: {
			Label: Common Shard Heal Amount
			Tooltip: Hit points restored when a Common Life Shard is consumed via quick-heal.
		}

		UncommonHealAmount: {
			Label: Uncommon Shard Heal Amount
			Tooltip: Hit points restored when an Uncommon Life Shard is consumed via quick-heal.
		}

		RareHealAmount: {
			Label: Rare Shard Heal Amount
			Tooltip: Hit points restored when a Rare Life Shard is consumed via quick-heal.
		}

		EpicHealAmount: {
			Label: Epic Shard Heal Amount
			Tooltip: Hit points restored when an Epic Life Shard is consumed via quick-heal.
		}

		LegendaryHealAmount: {
			Label: Legendary Shard Heal Amount
			Tooltip: Hit points restored when a Legendary Life Shard is consumed via quick-heal.
		}
	}

	VitalTilesConfig: {
		DisplayName: Vital Tiles Settings

		Headers: {
			General: General
			Spread: Spread Rates
			Buffs: Buff Strengths
			Seeds: Seed Drop Chances
		}

		SystemEnabled: {
			Label: Enable Vital Tiles System
			Tooltip: Master switch for the Vital Soil and Vital Quartz tiles, their buffs, plants, and the Life Crystal/Fruit seed drops. Turn this off to disable it completely.
		}

		VitalSoilSpreadChance: {
			Label: Vital Soil Spread Chance
			Tooltip: Per-random-update chance for a Vital Soil block to convert one adjacent Dirt, Mud, or Silt block. Set to 0 to disable spread.
		}

		VitalQuartzSpreadChance: {
			Label: Vital Quartz Spread Chance
			Tooltip: Per-random-update chance for a Vital Quartz block to convert one adjacent Stone block. Set to 0 to disable spread.
		}

		VitalSoilRegenPercent: {
			Label: Vital Soil Regen Boost (%)
			Tooltip: Percent of the player's current life regeneration added back while they stand on Vital Soil.
		}

		VitalQuartzMaxHpPercent: {
			Label: Vital Quartz Max HP Boost (%)
			Tooltip: Percent of maximum life added while the player is within range of a Vital Quartz block.
		}

		VitalQuartzVerticalRange: {
			Label: Vital Quartz Vertical Range (tiles)
			Tooltip: How far above or below a Vital Quartz block the aura reaches.
		}

		VitalQuartzHorizontalRange: {
			Label: Vital Quartz Horizontal Range (tiles)
			Tooltip: How far to either side of a Vital Quartz block the aura reaches. Smaller than vertical to encourage column-style placements.
		}

		LifeCrystalSeedChance: {
			Label: Life Crystal Seed Chance (%)
			Tooltip: Chance an extractinated Life Crystal also yields a Life Crystal Seed. The chance is independent of the standard shard yield.
		}

		LifeFruitSeedChance: {
			Label: Life Fruit Seed Chance (%)
			Tooltip: Chance an extractinated Life Fruit yields a Life Fruit Seed. Life Fruit extractination only produces seeds — a missed roll consumes the fruit for nothing.
		}
	}

	ElementalHeartsClientConfig: {
		DisplayName: Elemental Hearts Client Config

		Headers: {
			UI: U I Header
			Abilities: Abilities
		}

		EnableHeartChecklist: {
			Label: Enable Heart Checklist
			Tooltip: ""
		}

		ShowDetailedHeartStats: {
			Label: Show Detailed Heart Stats
			Tooltip: ""
		}

		EnableElementalHP: {
			Label: Enable Elemental H P
			Tooltip: ""
		}

		ShowPermanentBuffs: {
			Label: Show Permanent Buffs
			Tooltip: ""
		}

		HideImpossibleHearts: {
			Label: Hide Impossible Hearts
			Tooltip: ""
		}

		EnableJackOLanternDash: {
			Label: Enable Jack-O'-Lantern Dash
			Tooltip: Master switch for the Jack-O'-Lantern Heart's dash burst. The on/off toggle is in the Heart Log.
		}
	}

	ElementalHeartsCameraConfig: {
		DisplayName: Elemental Hearts Camera Config

		Headers: {
			General: General Header
			Strength: Strength Header
			Feel: Feel Header
			Behaviour: Behaviour Header
		}

		EnableCursorFocus: {
			Label: Enable Cursor Focus
			Tooltip: ""
		}

		MaxPanDistance: {
			Label: Max Pan Distance
			Tooltip: ""
		}

		HorizontalStrength: {
			Label: Horizontal Strength
			Tooltip: ""
		}

		VerticalStrength: {
			Label: Vertical Strength
			Tooltip: ""
		}

		Smoothing: {
			Label: Smoothing
			Tooltip: ""
		}

		Deadzone: {
			Label: Deadzone
			Tooltip: ""
		}

		ResponseCurve: {
			Label: Response Curve
			Tooltip: ""
		}

		OnlyWhileUsingItem: {
			Label: Only While Using Item
			Tooltip: ""
		}

		RecenterInMenus: {
			Label: Recenter In Menus
			Tooltip: ""
		}

		InvertHorizontal: {
			Label: Invert Horizontal
			Tooltip: ""
		}

		InvertVertical: {
			Label: Invert Vertical
			Tooltip: ""
		}
	}

	ElementalHeartsIdleConfig: {
		DisplayName: Elemental Hearts Idle Config
		Headers.IdleGameSettings: Idle Game Settings Header

		EnableIdleGame: {
			Label: Enable Idle Game
			Tooltip: If true, unlocked and consumed hearts will generate Life Shards over time.
		}

		BaseCapacity: {
			Label: Base Shard Capacity
			Tooltip: The base maximum amount of unclaimed shards you can hold.
		}

		CapacityPerTier: {
			Label: Capacity Per World Tier
			Tooltip: The additional maximum amount of unclaimed shards you can hold per World Tier.
		}
	}
}

Conditions: {
	LifeShardSystemEnabled: Life Shard System Enabled
	UIUpgradeOnly: Life Shard UI
	DownedLegendaryAnimate: Legendary Animate has been defeated
	CurrentAnimateTier: Current Animate Tier
	LifeShardSystemDisabled: Life Shard System Disabled
}

UI: {
	LifeShardPanel: Life
	SearchHearts: Search Hearts...
	Fuse: Fuse {0} {1} into a {2}
	TierCommon: Common
	TierUncommon: Uncommon
	TierRare: Rare
	TierEpic: Epic
	TierLegendary: Legendary
	AnimateTip:
		'''
		{0} locks the {1}...
		Spawn him with a {2}!
		'''
	AnimateTipNext: "{0} locks the {1}..."
	LiteChat1: In order to upgrade your life shards to the next tier, you must defeat Animate.
	LiteChat2: He can be spawned with a Menacing Heart, which is crafted with life shards and a life crystal at a Demon Altar.
	LiteChat3: I heard that once you defeat him, he will allow you access to higher tiers but he also gets stronger to guard the next tier.
	LiteChat4: Be safe!
}

