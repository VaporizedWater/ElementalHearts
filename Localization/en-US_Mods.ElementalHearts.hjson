# Every top-level key is auto-prefixed with "Mods.ElementalHearts." by tModLoader,
# so `Common.HpGain` below resolves at runtime as `Mods.ElementalHearts.Common.HpGain`.
#
# Heart display names that aren't listed here are auto-generated from the class name
# on first build (CamelCase splits into spaced words). Only override an entry when
# the auto-generated form would be wrong: missing apostrophe, lowercase "of"/"the"/
# "and", or a vanilla-name correction.
#
# ElementalPower (optional per heart) overrides the curated name from ElementalPowerRegistry.

Common: {
	HpGain: Permanently increases maximum life by {0}
	ElementalPowerActivated: The elemental power of the {0} has been activated
}

Configs: {
	ElementalHeartsServerConfig: {
		DisplayName: Server Settings

		Headers: {
			Boss: Boss Drops
			Capacity: Capacity
			HP: HP Scaling
			Recipes: Recipes
			World: World
			LifeShards: Life Shards
			VitalTiles: Vital Tiles
		}

		BossDrops: {
			Label: Boss Drop Settings
			Tooltip: ""
		}

		CapacityLimits: {
			Label: Capacity Settings
			Tooltip: ""
		}

		HPScale: {
			Label: HP Scaling Settings
			Tooltip: ""
		}

		Recipes: {
			Label: Recipe Settings
			Tooltip: ""
		}

		WorldGen: {
			Label: World Settings
			Tooltip: ""
		}

		LifeShards: {
			Label: Life Shard Settings
			Tooltip: ""
		}

		VitalTiles: {
			Label: Vital Tile Settings
			Tooltip: ""
		}
	}

	ElementalHeartsClientConfig: {
		DisplayName: Interface Settings

		Headers: {
			UI: Heart Log & HUD
			Camera: Camera
			Idle: Idle Game
			Tips: Tips
			Visuals: Visuals
			Abilities: Abilities
		}

		UI: {
			Label: UI Settings
			Tooltip: ""
		}

		Camera: {
			Label: Camera Settings
			Tooltip: ""
		}

		Idle: {
			Label: Idle Game Settings
			Tooltip: ""
		}

		Tips: {
			Label: Tips Settings
			Tooltip: ""
		}

		Visuals: {
			Label: Visual Settings
			Tooltip: ""
		}

		Abilities: {
			Label: Ability Settings
			Tooltip: ""
		}
	}

	BossSettings: {
		DisplayName: Boss Drop Settings
		Headers.Drops: Boss Heart Drops

		BossHeartsGuaranteedOnFirstKill: {
			Label: Guaranteed On First Kill
			Tooltip:
				'''
				If enabled, the very first time you defeat a boss it will always drop its themed heart.
				The drop chance below only applies on subsequent kills.
				'''
		}

		BossHeartDropChance: {
			Label: Boss Heart Drop Chance (%)
			Tooltip: Percentage chance for a boss to drop its themed heart on each kill after the first.
		}

		Tooltip: ""
	}

	ElementalHeartsCrossModConfig: {
		DisplayName: Cross-Mod Settings
		Headers.SupportedMods: Supported Mods

		EnableCalamityHearts: {
			Label: Enable Calamity Hearts
			Tooltip:
				'''
				Load hearts themed around Calamity Mod content.
				Disabling removes them entirely. They can't be crafted, dropped, or found.
				Requires a reload.
				'''
		}

		EnableThoriumHearts: {
			Label: Enable Thorium Hearts
			Tooltip:
				'''
				Load hearts themed around Thorium Mod content.
				Disabling removes them entirely. They can't be crafted, dropped, or found.
				Requires a reload.
				'''
		}

		EnableConsolariaHearts: {
			Label: Enable Consolaria Hearts
			Tooltip:
				'''
				Load hearts themed around Consolaria content.
				Disabling removes them entirely. They can't be crafted, dropped, or found.
				Requires a reload.
				'''
		}
	}

	HPSettings: {
		DisplayName: HP Settings

		Headers: {
			Challenge: Challenge Mode
			CraftableTiers: Craftable Heart Tiers
			BossTiers: Boss Heart Tiers
		}

		ChallengeMode: {
			Label: Challenge Mode
			Tooltip:
				'''
				Hardcore health rules. Your max life starts at 1 and Life Crystals give only 5 (down from 20),
				so hearts become your real path to a bigger health bar. To compensate, every heart grants
				double its configured HP. Disabled by default.
				'''
		}

		Common: {
			Label: Common Heart HP
			Tooltip: Maximum life each Common-tier heart grants when consumed. Default 2.
		}

		Uncommon: {
			Label: Uncommon Heart HP
			Tooltip: Maximum life each Uncommon-tier heart grants when consumed. Default 4.
		}

		Rare: {
			Label: Rare Heart HP
			Tooltip: Maximum life each Rare-tier heart grants when consumed. Default 6.
		}

		Epic: {
			Label: Epic Heart HP
			Tooltip: Maximum life each Epic-tier heart grants when consumed. Default 8.
		}

		Legendary: {
			Label: Legendary Heart HP
			Tooltip: Maximum life each Legendary-tier heart grants when consumed. Default 10.
		}

		Exotic: {
			Label: Exotic Heart HP
			Tooltip: Maximum life each Exotic-tier (vanilla boss) heart grants when consumed. Default 10.
		}

		Mythic: {
			Label: Mythic Heart HP
			Tooltip: Maximum life each Mythic-tier (Animate final-boss) heart grants when consumed. Default 50.
		}

		Tooltip: ""
	}

	RecipeSettings: {
		DisplayName: Recipe Settings
		Headers.Crafting: Crafting Difficulty

		RecipeDifficulty: {
			Label: Recipe Difficulty (x0.1 cost)
			Tooltip:
				'''
				Scales the materials every heart recipe needs.
				10 is the default (1x cost); 5 is half cost, 20 is double.
				Requires a reload.
				'''
		}

		Tooltip: ""
	}

	VisualSettings: {
		DisplayName: Visual Settings

		Headers: {
			Effects: Consumption Effect
			UI: Heads-Up Display
		}

		ConsumptionEffectStrength: {
			Label: Consumption Effect Strength
			Tooltip:
				'''
				Scales the particles, screen shake, and lighting of the heart-consumption effect.
				1 is subtle, 3 is the default, 5 is dramatic.
				'''
		}

		Tooltip: ""
	}

	TipSettings: {
		DisplayName: Tips Settings
		Headers.Tips: In-Game Tips

		EnableTips: {
			Label: Enable Tips
			Tooltip:
				'''
				When enabled, helpful in-game tips appear on the Life Shard UI (e.g. the Animate
				progression hint). Turn off to hide all tip badges.
				'''
		}

		Tooltip: ""
	}

	WorldSettings: {
		DisplayName: World Settings

		Headers: {
			Progression: Progression
			Cheats: Cheats
			ResetActions: Reset Actions (one-shot)
			Worldgen: Mini-Biome Generation
			NightEvents: Night Events
		}

		ClearHeartRegistry: {
			Label: Clear Consumed Hearts
			Tooltip:
				'''
				Enable to wipe this world's consumed-heart record and refund the max life it granted,
				so every heart can be consumed again. Resets itself once it runs.
				'''
		}

		ClearElementalTier: {
			Label: Clear Elemental Tier
			Tooltip:
				'''
				Enable to reset the Animate progression tier in this world back to the starting tier.
				Resets itself once it runs.
				'''
		}

		GenerateLifeBiomes: {
			Label: Generate Life Mini-Biomes
			Tooltip:
				'''
				When on, new worlds generate Vital Soil patches on the surface and heart-shaped
				Vital Quartz formations in the jungle. Only affects fresh worlds.
				'''
		}

		SurfaceBiomeCountMultiplier: {
			Label: Surface Biome Count Multiplier
			Tooltip:
				'''
				Multiplies the surface Vital Soil biome count. 1 is the default (~3 on small,
				~5 on medium, ~7 on large worlds). Set to 0 to disable surface biomes only.
				'''
		}

		JungleBiomeCountMultiplier: {
			Label: Jungle Biome Count Multiplier
			Tooltip: Multiplies the jungle Vital Quartz biome count. 1 is the default (~3 on small, ~4 on medium, ~6 on large worlds). Set to 0 to disable jungle biomes only.
		}

		HeartShootingStarChance: {
			Label: Heart Shooting Star Chance (%)
			Tooltip: Percent chance, on each eligible night, that heart shooting stars fall at all.
		}

		HeartShootingStarMaxPerNight: {
			Label: Heart Shooting Stars Per Night
			Tooltip: The most heart shooting stars that can fall during a single night.
		}

		HeartShootingStarFrequency: {
			Label: Heart Shooting Star Frequency
			Tooltip: How often stars attempt to fall once a night is active. Higher falls more often.
		}

		SharedProgression: {
			Label: Shared Progression
			Tooltip:
				'''
				When on, consuming a heart marks it used for the whole world, every player draws
				from one shared collection and each heart can only ever be consumed once.
				When off, every character keeps their own independent progress.
				'''
		}

		AdminMode: {
			Label: Admin Mode
			Tooltip:
				'''
				Reveals every heart in the Heart Log regardless of progression, for testing or
				spectating. Does not change what can actually be consumed.
				'''
		}

		Tooltip: ""

		HeartShootingStarFalloffMultiplier: {
			Tooltip: ""
			Label: Heart Shooting Star Falloff Multiplier
		}
	}

	LifeShardSettings: {
		DisplayName: Life Shard Settings

		Headers: {
			General: General
			DropChances: Damage-Based Drop Chances
			DamageThresholds: Damage Thresholds
			Extractinator: Extractinator Yields
			Consumable: Consumable Shards
			ActiveAbilityCosts: Active Ability Costs Header
			PassiveAbilityYields: Passive Ability Yields Header
		}

		SystemEnabled: {
			Label: Enable Life Shard System
			Tooltip: Master switch for the entire Life Shard system: both damage-based drops and all shard crafting. Turn this off to disable it completely.
		}

		CommonDropChance: {
			Label: Common Shard Drop Chance (%)
			Tooltip: Chance to drop a Common Life Shard the first time an enemy's cumulative damage reaches the Common threshold. Bosses roll at double this chance.
		}

		UncommonDropChance: {
			Label: Uncommon Shard Drop Chance (%)
			Tooltip: Chance to drop an Uncommon Life Shard the first time an enemy's cumulative damage reaches the Uncommon threshold. Bosses roll at double this chance.
		}

		RareDropChance: {
			Label: Rare Shard Drop Chance (%)
			Tooltip: Chance to drop a Rare Life Shard the first time an enemy's cumulative damage reaches the Rare threshold. Bosses roll at double this chance.
		}

		EpicDropChance: {
			Label: Epic Shard Drop Chance (%)
			Tooltip: Chance to drop an Epic Life Shard the first time an enemy's cumulative damage reaches the Epic threshold. Bosses roll at double this chance.
		}

		LegendaryDropChance: {
			Label: Legendary Shard Drop Chance (%)
			Tooltip: Chance to drop a Legendary Life Shard the first time an enemy's cumulative damage reaches the Legendary threshold. Bosses roll at double this chance.
		}

		CommonDamageThreshold: {
			Label: Common Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for a Common Life Shard.
		}

		UncommonDamageThreshold: {
			Label: Uncommon Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for an Uncommon Life Shard.
		}

		RareDamageThreshold: {
			Label: Rare Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for a Rare Life Shard.
		}

		EpicDamageThreshold: {
			Label: Epic Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for an Epic Life Shard.
		}

		LegendaryDamageThreshold: {
			Label: Legendary Shard Damage Threshold
			Tooltip: Total damage an enemy must accumulate before it rolls once for a Legendary Life Shard.
		}

		ExtractinatorCommonMin: {
			Label: Extractinator Common Minimum
			Tooltip: Fewest Common Life Shards a Life Crystal yields in the Extractinator.
		}

		ExtractinatorCommonMax: {
			Label: Extractinator Common Maximum
			Tooltip: Most Common Life Shards a Life Crystal yields in the Extractinator.
		}

		ExtractinatorUncommonChance: {
			Label: Extractinator Uncommon Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Uncommon Life Shards.
		}

		ExtractinatorUncommonMin: {
			Label: Extractinator Uncommon Minimum
			Tooltip: Fewest Uncommon Life Shards yielded when the Uncommon bonus roll succeeds.
		}

		ExtractinatorUncommonMax: {
			Label: Extractinator Uncommon Maximum
			Tooltip: Most Uncommon Life Shards yielded when the Uncommon bonus roll succeeds.
		}

		ExtractinatorRareChance: {
			Label: Extractinator Rare Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Rare Life Shards.
		}

		ExtractinatorRareMin: {
			Label: Extractinator Rare Minimum
			Tooltip: Fewest Rare Life Shards yielded when the Rare bonus roll succeeds.
		}

		ExtractinatorRareMax: {
			Label: Extractinator Rare Maximum
			Tooltip: Most Rare Life Shards yielded when the Rare bonus roll succeeds.
		}

		ExtractinatorEpicChance: {
			Label: Extractinator Epic Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Epic Life Shards.
		}

		ExtractinatorEpicMin: {
			Label: Extractinator Epic Minimum
			Tooltip: Fewest Epic Life Shards yielded when the Epic bonus roll succeeds.
		}

		ExtractinatorEpicMax: {
			Label: Extractinator Epic Maximum
			Tooltip: Most Epic Life Shards yielded when the Epic bonus roll succeeds.
		}

		ExtractinatorLegendaryChance: {
			Label: Extractinator Legendary Chance (%)
			Tooltip: Chance for a Life Crystal in the Extractinator to also yield Legendary Life Shards.
		}

		ExtractinatorLegendaryMin: {
			Label: Extractinator Legendary Minimum
			Tooltip: Fewest Legendary Life Shards yielded when the Legendary bonus roll succeeds.
		}

		ExtractinatorLegendaryMax: {
			Label: Extractinator Legendary Maximum
			Tooltip: Most Legendary Life Shards yielded when the Legendary bonus roll succeeds.
		}

		ShardsAreConsumable: {
			Label: Shards Are Consumable
			Tooltip: When on, Life Shards held in the regular inventory can be used as quick-heal items. Shards inside the Life Shard panel are never consumed.
		}

		ShardSicknessSeconds: {
			Label: Shard Sickness Duration (seconds)
			Tooltip: Seconds of Shard Sickness applied after consuming a Life Shard. Independent of Potion Sickness from healing potions.
		}

		CommonHealAmount: {
			Label: Common Shard Heal Amount
			Tooltip: Hit points restored when a Common Life Shard is consumed via quick-heal.
		}

		UncommonHealAmount: {
			Label: Uncommon Shard Heal Amount
			Tooltip: Hit points restored when an Uncommon Life Shard is consumed via quick-heal.
		}

		RareHealAmount: {
			Label: Rare Shard Heal Amount
			Tooltip: Hit points restored when a Rare Life Shard is consumed via quick-heal.
		}

		EpicHealAmount: {
			Label: Epic Shard Heal Amount
			Tooltip: Hit points restored when an Epic Life Shard is consumed via quick-heal.
		}

		LegendaryHealAmount: {
			Label: Legendary Shard Heal Amount
			Tooltip: Hit points restored when a Legendary Life Shard is consumed via quick-heal.
		}

		Tooltip: ""

		CommonAbilityCost: {
			Label: Common Ability Cost
			Tooltip: ""
		}

		UncommonAbilityCost: {
			Label: Uncommon Ability Cost
			Tooltip: ""
		}

		RareAbilityCost: {
			Label: Rare Ability Cost
			Tooltip: ""
		}

		EpicAbilityCost: {
			Label: Epic Ability Cost
			Tooltip: ""
		}

		LegendaryAbilityCost: {
			Label: Legendary Ability Cost
			Tooltip: ""
		}

		ExoticAbilityCost: {
			Label: Exotic Ability Cost
			Tooltip: ""
		}

		MythicAbilityCost: {
			Label: Mythic Ability Cost
			Tooltip: ""
		}

		CommonPassiveYield: {
			Label: Common Passive Yield
			Tooltip: ""
		}

		UncommonPassiveYield: {
			Label: Uncommon Passive Yield
			Tooltip: ""
		}

		RarePassiveYield: {
			Label: Rare Passive Yield
			Tooltip: ""
		}

		EpicPassiveYield: {
			Label: Epic Passive Yield
			Tooltip: ""
		}

		LegendaryPassiveYield: {
			Label: Legendary Passive Yield
			Tooltip: ""
		}

		ExoticPassiveYield: {
			Label: Exotic Passive Yield
			Tooltip: ""
		}

		MythicPassiveYield: {
			Label: Mythic Passive Yield
			Tooltip: ""
		}
	}

	VitalTileSettings: {
		DisplayName: Vital Tiles Settings

		Headers: {
			General: General
			Spread: Spread Rates
			Buffs: Buff Strengths
			Seeds: Seed Drop Chances
		}

		SystemEnabled: {
			Label: Enable Vital Tiles System
			Tooltip: Master switch for the Vital Soil and Vital Quartz tiles, their buffs, plants, and the Life Crystal/Fruit seed drops. Turn this off to disable it completely.
		}

		VitalSoilSpreadChance: {
			Label: Vital Soil Spread Chance
			Tooltip: Per-random-update chance for a Vital Soil block to convert one adjacent Dirt, Mud, or Silt block. Set to 0 to disable spread.
		}

		VitalQuartzSpreadChance: {
			Label: Vital Quartz Spread Chance
			Tooltip: Per-random-update chance for a Vital Quartz block to convert one adjacent Stone block. Set to 0 to disable spread.
		}

		VitalSoilRegenPercent: {
			Label: Vital Soil Regen Boost (%)
			Tooltip: Percent of the player's current life regeneration added back while they stand on Vital Soil.
		}

		VitalQuartzMaxHpPercent: {
			Label: Vital Quartz Max HP Boost (%)
			Tooltip: Percent of maximum life added while the player is within range of a Vital Quartz block.
		}

		VitalQuartzVerticalRange: {
			Label: Vital Quartz Vertical Range (tiles)
			Tooltip: How far above or below a Vital Quartz block the aura reaches.
		}

		VitalQuartzHorizontalRange: {
			Label: Vital Quartz Horizontal Range (tiles)
			Tooltip: How far to either side of a Vital Quartz block the aura reaches. Smaller than vertical to encourage column-style placements.
		}

		LifeCrystalSeedChance: {
			Label: Life Crystal Seed Chance (%)
			Tooltip: Chance an extractinated Life Crystal also yields a Life Crystal Seed. The chance is independent of the standard shard yield.
		}

		LifeFruitSeedChance: {
			Label: Life Fruit Seed Chance (%)
			Tooltip: Chance an extractinated Life Fruit yields a Life Fruit Seed. Life Fruit extractination only produces seeds. A missed roll consumes the fruit for nothing.
		}

		Tooltip: ""
	}

	UISettings: {
		DisplayName: Interface Settings

		Headers: {
			UI: Heart Log & HUD
			Abilities: Abilities
		}

		EnableHeartChecklist: {
			Label: Enable Heart Log
			Tooltip: Show the Heart Log checklist button and panel that tracks every heart you can find or craft.
		}

		ShowDetailedHeartStats: {
			Label: Show Detailed Stats Bar
			Tooltip: Show the detailed stats bar (totals and per-tier counts) at the bottom of the Heart Log.
		}

		EnableElementalHP: {
			Label: Enable Elemental HP Bar
			Tooltip:
				'''
				Recolour your life-bar hearts to match the highest tier you've consumed.
				Turn off to keep the vanilla red hearts.
				'''
		}

		ShowPermanentBuffs: {
			Label: Show Permanent Buff Icons
			Tooltip: Show buff icons for the permanent effects granted by consumed Potion Hearts.
		}

		HideImpossibleHearts: {
			Label: Hide Unobtainable Hearts
			Tooltip:
				'''
				Hide hearts you can't currently obtain (their source mod is disabled or absent)
				from the Heart Log, instead of greying them out.
				'''
		}

		DraggableUI: {
			Label: Draggable Life Shard UI
			Tooltip:
				'''
				When enabled, the Life Shard panel can be clicked and dragged to any screen position.
				The new position is saved automatically to UI Position below.
				'''
		}

		UIPosition: {
			Label: Life Shard UI Position
			Tooltip:
				'''
				Saved screen coordinates of the Life Shard panel. Only used while Draggable UI is enabled.
				Set both to 0 to fall back to the default location.
				'''
		}

		Tooltip: ""
	}

	CameraSettings: {
		DisplayName: Camera Settings

		Headers: {
			General: General
			Strength: Pan Strength
			Feel: Feel
			Behaviour: Behaviour
		}

		EnableCursorFocus: {
			Label: Enable Cursor Focus
			Tooltip:
				'''
				Global kill-switch for the Magnification Heart's camera pan. When off the camera
				never follows the cursor, regardless of the per-character Heart Log toggle.
				'''
		}

		MaxPanDistance: {
			Label: Max Pan Distance (px)
			Tooltip: How far, in pixels, the camera shifts when the cursor is pushed all the way to a screen edge.
		}

		HorizontalStrength: {
			Label: Horizontal Strength (%)
			Tooltip: Multiplier on the horizontal pan. 100 is full strength; 0 disables horizontal panning.
		}

		VerticalStrength: {
			Label: Vertical Strength (%)
			Tooltip: Multiplier on the vertical pan. 100 is full strength; 0 disables vertical panning.
		}

		Smoothing: {
			Label: Smoothing
			Tooltip: How floaty the follow feels. 0 snaps instantly to the cursor; 100 drifts in lazily.
		}

		Deadzone: {
			Label: Deadzone (%)
			Tooltip: Central area, as a percent of the half-screen, the cursor can sit in before the camera reacts.
		}

		ResponseCurve: {
			Label: Response Curve
			Tooltip:
				'''
				Easing of the pan. 1 is linear; higher values keep the camera calmer near the
				centre and only ramp up as the cursor nears the edge.
				'''
		}

		OnlyWhileUsingItem: {
			Label: Only While Using An Item
			Tooltip: When on, the camera only pans while you are actively swinging or aiming an item.
		}

		RecenterInMenus: {
			Label: Recenter In Menus
			Tooltip: When on, opening the inventory or any mod menu glides the camera back to centre.
		}

		InvertHorizontal: {
			Label: Invert Horizontal
			Tooltip: Flip the horizontal pan direction.
		}

		InvertVertical: {
			Label: Invert Vertical
			Tooltip: Flip the vertical pan direction.
		}

		Tooltip: ""
	}

	IdleSettings: {
		DisplayName: Idle Game Settings
		Headers.IdleGameSettings: Idle Shard Generation

		EnableIdleGame: {
			Label: Enable Idle Game
			Tooltip: When on, unlocked and consumed hearts slowly generate Life Shards over time for you to claim.
		}

		BaseCapacity: {
			Label: Base Shard Capacity
			Tooltip: The base maximum number of unclaimed shards you can bank before generation pauses.
		}

		CapacityPerTier: {
			Label: Capacity Per World Tier
			Tooltip: Extra unclaimed-shard capacity granted for each World Tier you've reached.
		}

		Tooltip: ""
	}

	CapacitySettings: {
		DisplayName: Capacity Settings
		Headers.ProgressionGates: HP Capacity Gates

		EnableProgressionGates: {
			Label: Enable Capacity Gates
			Tooltip:
				'''
				When on, the total max-life bonus you can bank from hearts is capped at each
				stage of boss progression, so your health can't outrun the world.
				Turn off to consume hearts freely.
				'''
		}

		PreBossCapacity: {
			Label: Cap: Pre-Boss
			Tooltip: Maximum heart HP bonus allowed before any boss is defeated.
		}

		PostSkeletronCapacity: {
			Label: Cap: After Skeletron
			Tooltip: Maximum heart HP bonus allowed after Skeletron is defeated.
		}

		PostWoFCapacity: {
			Label: Cap: After Wall of Flesh
			Tooltip: Maximum heart HP bonus allowed after the Wall of Flesh (entering Hardmode).
		}

		Post1MechCapacity: {
			Label: Cap: After 1 Mech Boss
			Tooltip: Maximum heart HP bonus allowed after defeating one Mechanical Boss.
		}

		Post2MechsCapacity: {
			Label: Cap: After 2 Mech Bosses
			Tooltip: Maximum heart HP bonus allowed after defeating two Mechanical Bosses.
		}

		Post3MechsCapacity: {
			Label: Cap: After 3 Mech Bosses
			Tooltip: Maximum heart HP bonus allowed after defeating all three Mechanical Bosses.
		}

		PostPlanteraCapacity: {
			Label: Cap: After Plantera
			Tooltip: Maximum heart HP bonus allowed after Plantera is defeated.
		}

		PostGolemCapacity: {
			Label: Cap: After Golem
			Tooltip: Maximum heart HP bonus allowed after Golem is defeated.
		}

		PostCultistCapacity: {
			Label: Cap: After Lunatic Cultist
			Tooltip: Maximum heart HP bonus allowed after the Lunatic Cultist is defeated.
		}

		PostMoonLordCapacity: {
			Label: Cap: After Moon Lord
			Tooltip: Maximum heart HP bonus allowed after Moon Lord is defeated.
		}

		UnlimitedPostMoonLord: {
			Label: Uncap After Moon Lord
			Tooltip: When on, the capacity gate is removed entirely once Moon Lord is defeated.
		}

		Tooltip: ""
	}

	AbilitySettings: {
		EnableJackOLanternDash: {
			Label: Enable Jack-O'-Lantern Dash
			Tooltip:
				'''
				Master switch for the Jack-O'-Lantern Heart's dash burst.
				The everyday on/off toggle lives in the Heart Log.
				'''
		}

		Tooltip: ""
	}
}

Conditions: {
	LifeShardSystemEnabled: Life Shard System Enabled
	UIUpgradeOnly: Life Shard UI
	DownedLegendaryAnimate: Legendary Animate has been defeated
	CurrentAnimateTier: Current Animate Tier
	LifeShardSystemDisabled: Life Shard System Disabled
}

UI: {
	LifeShardPanel: Life
	SearchHearts: Search Hearts...
	Fuse: Fuse {0} {1} into a {2}
	TierCommon: Common
	TierUncommon: Uncommon
	TierRare: Rare
	TierEpic: Epic
	TierLegendary: Legendary
	AnimateTip:
		'''
		{0} locks the {1}...
		Spawn him with a {2}!
		'''
	AnimateTipNext: "{0} locks the {1}..."
	LiteChat1: In order to upgrade your life shards to the next tier, you must defeat Animate.
	LiteChat2: He can be spawned with a Menacing Heart, which is crafted with life shards and a life crystal at a Demon Altar.
	LiteChat3: I heard that once you defeat him, he will allow you access to higher tiers but he also gets stronger to guard the next tier.
	LiteChat4: Be safe!
}

# Display-name overrides. Anything not listed auto-generates from the class name.
Items: {
	EaterOfWorldsHeart: {
		DisplayName: Eater of World's Heart
		Tooltip: ""
		Lore: Pulled segment by reluctant segment from the longest, hungriest worm the corruption ever grew. It beats with a slow, decaying rhythm that feeds on rot and somehow calls it a meal plan. One of many hearts you will swallow without once asking where it has been.
	}

	AcornHeart: {
		DisplayName: Acorn Heart
		Tooltip: Permanently increases tree loot by 25%
		Lore: Every towering oak begins as something small enough to lose in a pocket, and this seed never forgot it. It beats with quiet, patient ambition, already dreaming of the forest it fully intends to become. Tiny, humble, and carrying more potential than most hearts twice its size.
	}

	GemcornHeart: {
		DisplayName: Gemcorn Heart
		Tooltip: Permanently allows you to harvest gems from trees
		Lore: Plant the right seed in the right gem and the caverns grow you a tree that drips treasure, which this heart finds perfectly reasonable. It beats with a sharp crystalline chime, smug about being the only seed that pays dividends. Greedy, glittering, and proud of every single carat.
	}

	CommonMenacingHeart: {
		DisplayName: Menacing Heart
		Tooltip: Summons Animate
	}

	UncommonMenacingHeart: {
		DisplayName: Menacing Heart
		Tooltip: Summons Animate
	}

	RareMenacingHeart: {
		DisplayName: Menacing Heart
		Tooltip: Summons Animate
	}

	EpicMenacingHeart: {
		DisplayName: Menacing Heart
		Tooltip: Summons Animate
	}

	LegendaryMenacingHeart: {
		DisplayName: Menacing Heart
		Tooltip: Summons Animate
	}

	CommonPacifiedHeart: {
		DisplayName: Pacified Heart
		ElementalPower: common
		Tooltip: ""
	}

	UncommonPacifiedHeart: {
		DisplayName: Pacified Heart
		ElementalPower: uncommon
		Tooltip: ""
	}

	RarePacifiedHeart: {
		DisplayName: Pacified Heart
		ElementalPower: rare
		Tooltip: ""
	}

	EpicPacifiedHeart: {
		DisplayName: Pacified Heart
		ElementalPower: epic
		Tooltip: ""
	}

	LegendaryPacifiedHeart: {
		DisplayName: Pacified Heart
		ElementalPower: legendary
		Tooltip: ""
	}

	UncommonAnimatingPotion: {
		Tooltip:
			'''
			5% increased maximum life
			10% increased elemental heart life
			'''
		DisplayName: Uncommon Animating Potion
	}

	RareAnimatingPotion: {
		Tooltip:
			'''
			5% increased maximum life
			15% increased elemental heart life
			'''
		DisplayName: Rare Animating Potion
	}

	LegendaryAnimatingPotion: {
		Tooltip:
			'''
			5% increased maximum life
			25% increased elemental heart life
			'''
		DisplayName: Legendary Animating Potion
	}

	EpicAnimatingPotion: {
		Tooltip:
			'''
			5% increased maximum life
			20% increased elemental heart life
			'''
		DisplayName: Epic Animating Potion
	}

	CommonAnimatingPotion: {
		Tooltip:
			'''
			5% increased maximum life
			5% increased elemental heart life
			'''
		DisplayName: Common Animating Potion
	}

	UncommonLifeShard: {
		Tooltip: ""
		DisplayName: Life Shard
	}

	RareLifeShard: {
		Tooltip: ""
		DisplayName: Life Shard
	}

	LegendaryLifeShard: {
		Tooltip: ""
		DisplayName: Life Shard
	}

	EpicLifeShard: {
		Tooltip: ""
		DisplayName: Life Shard
	}

	CommonLifeShard: {
		Tooltip: ""
		DisplayName: Life Shard
	}

	TungstenHeart: {
		Tooltip: ""
		DisplayName: Tungsten Heart
		Lore: Heavier than it has any right to be and quietly tougher than the silver it politely stands in for. This heart beats with a dense, stubborn rhythm that refuses to be impressed by anything. Unflashy, hard to break, and entirely at peace with being underestimated.
	}

	TopazHeart: {
		Tooltip: ""
		DisplayName: Topaz Heart
		Lore: The humble amber gem the caverns hand out early, warm as desert light and twice as patient. It beats with a dry, golden glow that asks for nothing and quietly outlasts everything. A modest treasure that earned its place long before the fancier stones showed up.
	}

	TinHeart: {
		Tooltip: ""
		DisplayName: Tin Heart
		Lore: Copper's slightly sturdier cousin, here to prove that first ore wasn't a one-time fluke. It beats with a light, eager rhythm, thrilled simply to have been picked at all. Modest, willing, and far prouder than its weight has any right to be.
	}

	SilverHeart: {
		Tooltip: ""
		DisplayName: Silver Heart
		Lore: Cool, bright, and elegant in the understated way only silver ever manages. This heart beats with a clean, polished rhythm that catches the moonlight and decides to keep it. Refined enough to feel expensive, honest enough never to pretend it's gold.
	}

	SapphireHeart: {
		Tooltip: ""
		DisplayName: Sapphire Heart
		Lore: A deep blue gem dredged from the quiet places where the underground keeps its calm. It beats with a cool, serene rhythm, entirely untroubled by the chaos happening directly above it. Precious, composed, and far too dignified to ever panic.
	}

	RubyHeart: {
		Tooltip: ""
		DisplayName: Ruby Heart
		Lore: A red gem that glows like it is cradling a small, very well-mannered fire. This heart beats with passionate, royal warmth, certain it is the most important stone in any room. Bold, radiant, and almost entirely correct about that.
	}

	PlatinumHeart: {
		Tooltip: ""
		DisplayName: Platinum Heart
		Lore: Gold's wealthier alternate, doing the exact same job while looking faintly superior about it. This heart beats with refined, nearly indestructible confidence, the kind you get from winning a lottery you never entered. Elite, gleaming, and far too polished to apologize for either.
	}

	LeadHeart: {
		Tooltip: ""
		DisplayName: Lead Heart
		Lore: Iron's denser, heavier twin, the one that turns up when the world hands you the moody version. It beats with a slow, weighty thud that picks resilience over speed every single time. Sluggish, sturdy, and completely unbothered by your opinion of it.
	}

	IronHeart: {
		Tooltip: ""
		DisplayName: Iron Heart
		Lore: The first metal that ever made you feel like you owned a real anvil instead of a hopeful rock. This heart beats with the steady, dependable rhythm of actual progress finally arriving. The honest workhorse your whole collection quietly owes its early survival to.
	}

	GoldHeart: {
		Tooltip: ""
		DisplayName: Gold Heart
		Lore: By now you've banked enough hearts to fill a vault, and gold is the one that finally looks the part. It pumps with the smug, unhurried confidence of something worth more than the meal it is about to become. Down it goes, richer than anything else you own, and far too dignified to complain.
	}

	EnchantedHeart: {
		Tooltip: ""
		DisplayName: Enchanted Heart
		Lore: Shimmering with the pale, mysterious light usually reserved for swords buried dramatically in stone. This heart beats with a quiet, magical rhythm that hints it knows a secret or two. Elusive, glowing, and convinced it was always destined for greater things.
	}

	EmeraldHeart: {
		Tooltip: ""
		DisplayName: Emerald Heart
		Lore: A brilliant green gem carrying the wild, overgrown spirit of the jungle in crystal form. It beats with a vibrant, living rhythm, greener than anything that has business being a mineral. Lush, precious, and bursting with far more life than its tier lets on.
	}

	CopperHeart: {
		Tooltip: ""
		DisplayName: Copper Heart
		Lore: Somewhere along the line you decided that eating hearts made of metal was normal, and copper is where that proud tradition began. It beats with the scrappy nerve of a first step nobody photographs but everybody takes. Swallow it and pretend, like the rest of us, that this is a perfectly reasonable thing to do.
	}

	AmethystHeart: {
		Tooltip: ""
		DisplayName: Amethyst Heart
		Lore: The first gem the caverns ever pressed into your hand, violet and quietly grounding. It beats with a faint, steadying hum drawn straight from the geode-studded dark. Humble among gems, yet the one that quietly started your entire glittering habit.
	}

	WormHeart: {
		Tooltip: ""
		DisplayName: Worm Heart
		Lore: Wrenched from something long, segmented, and far too hungry for its own good. This heart beats with an insatiable, squirming rhythm that wants flesh and isn't shy about saying so. Repulsive, relentless, and weirdly admirable in its single-minded appetite.
	}

	SoulOfNightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Night Heart
		Lore: Distilled from the whispering dark of the deepest hardmode caverns, where braver explorers than you have turned back. It beats with a low, ominous pulse, humming secrets nobody actually asked to hear. Sinister, valuable, and quietly thrilled to be feared.
	}

	SoulOfLightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Light Heart
		Lore: Wrung from the blinding brilliance of the Hallow, where everything is a touch too cheerful to fully trust. It beats with a pure, radiant rhythm that scatters shadow whether the shadow agreed to it or not. Holy, dazzling, and utterly certain it is on the correct side of history.
	}

	SoulOfFlightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Flight Heart
		Lore: Harvested from the wyverns that patrol the clouds and deeply resent anyone joining them up there. This heart beats with a light upward tug, forever convinced it belongs in the sky rather than your hand. Weightless, restless, and quietly plotting its next takeoff.
	}

	PalladiumHeart: {
		Tooltip: ""
		DisplayName: Palladium Heart
		Lore: The cheerful orange option from the first batch of hardmode ore, eager to patch you up whether you asked or not. It beats with a warm, regenerating pulse that simply refuses to stay injured. Bright, stubbornly helpful, and proud to be the friendliest metal you'll swallow all run.
	}

	OrichalcumHeart: {
		Tooltip: ""
		DisplayName: Orichalcum Heart
		Lore: Pink, pretty, and far deadlier than its color lets anyone assume. This heart beats with a blossoming rhythm that drops flower petals on everything it dislikes. Delicate to look at, ruthless in practice, and thrilled by the contrast.
	}

	MythrilHeart: {
		Tooltip: ""
		DisplayName: Mythril Heart
		Lore: The mid-journey metal you finally smelt once a Demon Altar has been dramatically shattered. It beats with a light, arcane hum, quietly confident that it's the upgrade which actually mattered. Verdant, capable, and a little smug about being the turning point.
	}

	MeteoriteHeart: {
		Tooltip: ""
		DisplayName: Meteorite Heart
		Lore: A piece of the sky fell an unfathomable distance purely so that you could one day eat it in heart form. It beats with the warm ember glow of a very long journey finally ended. Treat it with reverence; it came further than anything else in the collection just to become a snack.
	}

	IchorHeart: {
		Tooltip: ""
		DisplayName: Ichor Heart
		Lore: Golden ichor wept from the Crimson's nastier residents, sticky and faintly divine. This heart beats while dribbling a corrosive shine that strips the armor off anything standing too close. Holy, revolting, and weirdly proud of being both at once.
	}

	HellstoneHeart: {
		Tooltip: ""
		DisplayName: Hellstone Heart
		Lore: You went to the lowest, most flammable place imaginable and returned with a heart that is, somehow, still on fire. It beats with molten resolve, warm enough to remind your hand that this was a choice you made freely. It demands courage, honors the bold, and will not be apologizing for the burns.
	}

	DiscordHeart: {
		Tooltip: Grants a hotkey to teleport to the cursor position at the cost of life
		DisplayName: Discord Heart
		Lore: Cracked loose from the same chaotic magic that lets you blink across the map and pay for it in pure confusion. This heart beats out of sync with space itself, here one instant and a regrettable distance away the next. Unstable, dizzying, and entirely worth the headache.
	}

	EncumberingHeart: {
		Tooltip: Permanently unlocks ground pounding. Press down in midair to perform a ground pound.
		DisplayName: Encumbering Heart
		Lore: So absurdly heavy it taught its owner to fall with purpose instead of merely falling. This heart beats with a slow, weighted thud that would rather crash down than stand still. A burden, technically, but the kind you eventually learn to aim.
	}

	TreasureHeart: {
		Tooltip: Permanently increases item pickup range.
		DisplayName: Treasure Heart
		Lore: Crammed with so much loose treasure it drags coins toward you out of sheer greed. This heart beats with a jingling, magnetic rhythm that hates leaving anything on the ground. Glorious, grabby, and absolutely certain that counts as a virtue.
	}

	DiamondHeart: {
		Tooltip: ""
		DisplayName: Diamond Heart
		Lore: Naturally the prettiest gem also makes the most insufferably perfect heart, flawless under any pressure you apply. It beats with cool, faceted poise, refracting light like it is posing for a portrait nobody asked it to sit for. Rare, radiant, and fully aware it is the finest thing you will swallow today.
	}

	DemoniteHeart: {
		Tooltip: ""
		DisplayName: Demonite Heart
		Lore: Mined from the Corruption, meaning your world rolled the evil purple worm option instead of the evil red brain. The eternal debate rages on, and this heart very much picked a side. It beats with a shadowy, abyssal pulse that whispers of ruined land and genuinely excellent loot.
	}

	DarkHeart: {
		Tooltip: ""
		DisplayName: Dark Heart
		Lore: A heart so thoroughly committed to darkness that light politely excuses itself from the area. It beats in total silence, swallowing every stray glimmer that drifts too close. Bleak, theatrical, and quietly having the time of its life about it.
	}

	CursedFlameHeart: {
		Tooltip: ""
		DisplayName: Cursed Flame Heart
		Lore: Lit with the sickly green fire the Corruption invented specifically so it would never go out. This heart beats while quietly burning, immune to water, reason, and second thoughts. Eternal, spiteful, and weirdly dependable as a light source.
	}

	CrimtaneHeart: {
		Tooltip: ""
		DisplayName: Crimtane Heart
		Lore: The Crimson's answer to demonite, for worlds that rolled the evil red brain instead of the worm. This heart beats with a sweet, infectious, faintly predatory rhythm that's hungrier than it looks. Sinister, vital, and proud of exactly which team it landed on.
	}

	CogHeart: {
		Tooltip: ""
		DisplayName: Cog Heart
		Lore: An assembly of brass gears and valves that ticks where lesser hearts merely beat. It runs with the precise, mechanized rhythm of a Steampunker's finest afternoon. Industrious, overengineered, and faintly offended by anything organic.
	}

	CobaltHeart: {
		Tooltip: ""
		DisplayName: Cobalt Heart
		Lore: The first metal you mine the instant the altars start shattering, blue and brimming with new speed. This heart beats quick and eager, thrilled to finally be playing in the big leagues. Vivid, energetic, and proud to mark the start of the second half.
	}

	BrainHeart: {
		Tooltip: ""
		DisplayName: Brain Heart
		Lore: A wad of gray matter and sinew yanked from the Crimson's floating overlord, still convinced it can outthink you. This heart beats with a maddening, scheming pulse that wants to consume and can't quite say why. Grotesque, clever, and the closest a heart ever gets to plotting.
	}

	AmberHeart: {
		Tooltip: ""
		DisplayName: Amber Heart
		Lore: An ancient gem of fossilized resin, holding a prehistoric calm older than anything still walking around. It beats with a slow, sun-warmed patience that has outlasted entire eras out of pure stubbornness. Golden, timeless, and in absolutely no hurry.
	}

	ZenithHeart: {
		Tooltip: ""
		DisplayName: Zenith Heart
		Lore: The reward for outlasting every trial and then gathering nearly every blade you ever owned into one absurd, sky-splitting whole. This heart beats with the combined pride of a thousand victories stacked into a single pulse. If it sits in your collection, you have nothing left to prove to anyone.
	}

	SpectreHeart: {
		Tooltip: ""
		DisplayName: Spectre Heart
		Lore: Woven from dungeon spirits and the ectoplasm they leave lying around, caught forever between living and not. This heart beats with a soft phantom rhythm, equally comfortable healing you or haunting you. Ghostly, balanced, and politely unsure which side of death it's on.
	}

	ShroomiteHeart: {
		Tooltip: ""
		DisplayName: Shroomite Heart
		Lore: Grown deep in the glowing mushroom biome, where the light runs blue and the stealth runs real. This heart beats with a quiet, spore-laced pulse that would honestly rather you didn't notice it. Luminous, sneaky, and proud of doing its best work unseen.
	}

	LuminiteHeart: {
		Tooltip: ""
		DisplayName: Luminite Heart
		Lore: Pried from the rubble of the celestial pillars by someone who clearly won the hardest fight on offer. This heart beats with the final, world-shaping glow of the very last ore there is. Radiant, ultimate, and well aware there's nothing left to mine after it.
	}

	EctoplasmHeart: {
		Tooltip: ""
		DisplayName: Ectoplasm Heart
		Lore: Skimmed from the restless spirits haunting the dungeon's deepest, least advisable rooms. This heart beats with a cold, ghostly flicker that drifts more than it pumps. Ethereal, eerie, and faintly amused to still be beating at all.
	}

	WallOfFleshHeart: {
		Tooltip: ""
		DisplayName: Wall Of Flesh Heart
		Lore: Finally, a boss that came with organs, so the "why is this a heart" question answers itself for once. You threw a man into lava, summoned the gatekeeper of the world's second age, and tore this still-twitching slab from the literal core of the world. It beats because it never got the memo that it's dead, and neither did your world.
	}

	SkeletronHeart: {
		Tooltip: ""
		DisplayName: Skeletron Heart
		Lore: Talk to the Old Man at night, pry the skull off the dungeon's bouncer, and walk away with the keys. This heart rattles more than it beats, cursed and hollow and somehow still on the clock. Ancient, stubborn, and the entire reason you're finally allowed inside.
	}

	RazorpineHeart: {
		Tooltip: ""
		DisplayName: Razorpine Heart
		Lore: Bristling with the icy needles of a razor-thorned tree that only turns up when the Frost Moon does. This heart beats with an evergreen chill, festive and faintly homicidal in equal measure. Sharp, seasonal, and far merrier than it has any right to be.
	}

	QueenSlimeHeart: {
		Tooltip: ""
		DisplayName: Queen Slime Heart
		Lore: The Hallow's crowned blob of crystal and bounce, regal in the way only a giant slime can manage. This heart beats with a glittering, springy rhythm that takes itself very seriously between bounces. Sparkling, bouncy, and absolutely convinced of its own majesty.
	}

	QueenBeeHeart: {
		Tooltip: ""
		DisplayName: Queen Bee Heart
		Lore: Torn from the matriarch of the jungle hive, still sticky with nectar and simmering fury. This heart beats with a furious buzz, royal and sweet and ready to summon the swarm at the slightest insult. Golden, regal, and not a creature you ever want to disappoint.
	}

	PumpkingHeart: {
		Tooltip: ""
		DisplayName: Pumpking Heart
		Lore: Harvested on the darkest night of the Pumpkin Moon, grinning the way only a flaming gourd can. This heart beats with a wicked, candlelit flicker that finds your fear absolutely delightful. Macabre, festive, and the proud king of everything spooky.
	}

	PlanteraHeart: {
		Tooltip: ""
		DisplayName: Plantera Heart
		Lore: Ripped from the bloom that waits in the jungle's depths to punish anyone who breaks a bulb. This heart beats with a wild, thrashing, overgrown rhythm that does not forgive trespassers. Fierce, untamed, and the gatekeeper of nearly everything that comes after.
	}

	MourningWoodHeart: {
		Tooltip: ""
		DisplayName: Mourning Wood Heart
		Lore: Carved from a scorched, cursed treant that wanders in on the spookiest nights of the year. This heart beats with a somber, smoldering pulse, equal parts grief and quiet arson. Gloomy, fiery, and weirdly poetic about the whole situation.
	}

	MoonLordHeart: {
		Tooltip: ""
		DisplayName: Moon Lord Heart
		Lore: You climbed past every lesser trophy in your hoard to reach the one the sky itself was hiding. Its heart beats with the cold gravity of a final act, pumping borrowed starlight with theatrical menace. Claim it and own the summit, because nothing left will ever beat quite this dramatically.
	}

	MartianSaucerHeart: {
		Tooltip: ""
		DisplayName: Martian Saucer Heart
		Lore: Salvaged from the high-tech invaders who beamed down uninvited and immediately came to regret it. This heart beats with a cold electronic hum, far more circuit board than muscle. Alien, blinking, and faintly disappointed in your primitive biology.
	}

	LunaticCultistHeart: {
		Tooltip: ""
		DisplayName: Lunatic Cultist Heart
		Lore: The robed fanatic who kneels outside the dungeon until you ruin his ritual by simply showing up. This heart beats with swirling forbidden starlight and the faint smugness of someone who scheduled the apocalypse. Ominous, prophetic, and the last polite warning before the moon falls.
	}

	KingSlimeHeart: {
		Tooltip: Permanently bounce on enemies.
		DisplayName: King Slime Heart
		Lore: He is a king, he is made of jelly, his heart wobbles instead of beats, and we have all politely agreed not to bring it up. It jiggles with the regal certainty of a monarch who arrives uninvited and leaves a legend behind. Optional, absurd, and far too proud to be skipped quietly.
	}

	GolemHeart: {
		Tooltip: ""
		DisplayName: Golem Heart
		Lore: A sun-charged power cell hauled out of the Jungle Temple by anyone bold enough to spend a Lihzahrd Power Cell. This heart beats with a slow, ancient, earthen thrum older than the traps that guarded it. Heavy, glowing, and quietly resentful of being moved.
	}

	FlyingDutchmanHeart: {
		Tooltip: ""
		DisplayName: Flying Dutchman Heart
		Lore: Salvaged from the ghost ship that sails in during the Pirate Invasion to ruin a perfectly nice afternoon. This heart beats with the creak of phantom rigging and a crew that never quite clocked out. Weathered, restless, and still technically at sea.
	}

	EyeOfCthulhuHeart: {
		Tooltip: Summons a Servant of Cthulhu minion that scales with game progression
		DisplayName: Eye Of Cthulhu Heart
		Lore: It is an eye, it now has a heart, and you have wisely stopped asking how either of those works. This one beats with the giddy terror of a first true victory, the night you learned you were the dangerous one. Add it to the pile and let it keep watching; it has earned the view.
	}

	EmpressOfLightHeart: {
		Tooltip: ""
		DisplayName: Empress Of Light Heart
		Lore: Wrung from the dazzling fairy who turns the night sky into a light show and you into confetti if you fight her by day. This heart beats in blinding prismatic color, graceful right up until the instant it isn't. Radiant, regal, and one wrong move from being the last thing you ever see.
	}

	ElfHeart: {
		Tooltip: ""
		DisplayName: Elf Heart
		Lore: Mischief bottled straight from the Frost Legion, all festive chill and questionable intentions. This heart beats with a cold, twinkling rhythm that's about sixty percent holiday cheer and forty percent prank. Frosty, playful, and never entirely trustworthy.
	}

	DukeFishronHeart: {
		Tooltip: ""
		DisplayName: Duke Fishron Heart
		Lore: Pried from the mutant pig-dragon-fish that lurks where the ocean meets the genuinely cursed. This heart beats with salt spray and barely contained oceanic rage, all summoned by something as silly as a Truffle Worm. Damp, furious, and far stronger than anything that goofy has a right to be.
	}

	DestroyerHeart: {
		Tooltip: ""
		DisplayName: Destroyer Heart
	}

	DeerclopsHeart: {
		Tooltip:
			'''
			Press the Parry keybind to flare pink for a moment
			Touch an enemy while flaring to body-check it for 10x its contact damage, taking none yourself
			A clean parry grants brief invincibility; usable once every 15 seconds
			'''
		DisplayName: Deerclops Heart
		Lore: Cold to the touch and echoing with the blizzard that birthed the one-eyed giant of the tundra. This heart beats with a slow, primal chill, the kind that watches from the treeline before it charges. Ancient, frostbitten, and deeply unimpressed by your campfire.
	}

	BrainOfCthulhuHeart: {
		Tooltip: ""
		DisplayName: Brain Of Cthulhu Heart
		Lore: The Crimson's floating overlord, reduced to a heart that still thinks it is in charge of something. It beats with a maddening whisper, leaking secrets nobody requested and several they regret hearing. Grotesque, paranoid, and absolutely certain you are being followed.
	}

	BetsyHeart: {
		Tooltip: ""
		DisplayName: Betsy Heart
		Lore: Wrenched from the Etherian dragon that closes out the Old One's Army with a faceful of fire. This heart beats with a warm, smoky pulse, proud and ancient and faintly singed. Fierce, radiant, and the kind of warmth that doubles as a threat.
	}

	TitaniumHeart: {
		Tooltip: ""
		DisplayName: Titanium Heart
		Lore: The tougher of the late ore twins, the one that bolts together a genuinely intimidating set of armor. This heart beats with a hard, shielded rhythm that shrugs off hits the way it shrugs off compliments. Resilient, sleek, and quietly the better pick.
	}

	SoulOfSightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Sight Heart
		Lore: Distilled from the Twins, the floating eyeballs that watch you fail and then report back to each other. This heart beats with an all-seeing flicker, certain it noticed something you definitely missed. Watchful, mechanical, and a little too pleased with the view.
	}

	SoulOfMightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Might Heart
		Lore: Wrung from the Destroyer, a colossal mechanical worm that made spawning probes its entire personality. This heart beats with raw, riveted strength, all torque and no doubt. Heavy, relentless, and proud of every single bolt.
	}

	SoulOfFrightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Fright Heart
		Lore: Screamed loose from Skeletron Prime, the mechanical skull with four arms and zero chill. This heart beats with a shrieking, dread-soaked rhythm that runs on pure intimidation. Terrifying, metallic, and thrilled that you flinched.
	}

	MechanicalHeart: {
		Tooltip: ""
		DisplayName: Mechanical Heart
		Lore: Gears and pistons ticking in cold, flawless sync, the souls of all three mechanical bosses bottled together. This heart runs instead of beats, precise enough to make a real one feel embarrassingly sloppy. Industrial, tireless, and faintly contemptuous of muscle.
	}

	HallowedHeart: {
		Tooltip: ""
		DisplayName: Hallowed Heart
		Lore: Forged from the blessed bars the mechanical bosses cough up once you finally beat all three. This heart beats with an overwhelming holy glare that banishes shadow on principle alone. Radiant, righteous, and the well-earned reward for surviving the gauntlet.
	}

	ShardHeart: {
		Tooltip: ""
		DisplayName: Shard Heart
		Lore: Assembled from razor fragments of glass that gleam far prettier than they are safe to hold. This heart beats in sharp, jagged flashes, scattering broken light with every cut. Dangerous, dazzling, and best admired from a respectful distance.
	}

	CrystalHeart: {
		Tooltip: ""
		DisplayName: Crystal Heart
		Lore: A many-faceted gem that splits a single torch beam into a small private light show. This heart beats with a clear, resonant chime, the favorite frequency of the crystal-studded caverns. Dazzling, musical, and quietly proud of its angles.
	}

	LifeFruitHeart: {
		Tooltip: ""
		DisplayName: Fruit Heart
		Lore: Bursting with the golden hyper-vitality the jungle only hands out once Plantera has been dealt with. This heart beats so hard it nearly bursts, packed with more life than is strictly polite. Plump, glowing, and one good thump from going off like a balloon.
	}

	ChlorophyteHeart: {
		Tooltip: ""
		DisplayName: Chlorophyte Heart
		Lore: A living ore that spreads through the jungle like it pays rent there, hungry for light at all hours. This heart beats and grows at the same time, restless and faintly photosynthetic. Verdant, ambitious, and convinced it could take over given one free afternoon.
	}

	AdamantiteHeart: {
		Tooltip: ""
		DisplayName: Adamantite Heart
		Lore: The fierier of the second-tier hardmode ores, red-hot and proud of surviving the forge. This heart beats with a stubborn, near-unbreakable rhythm earned the hard way. Tough, glowing, and the reward for not giving up back at the altars.
	}

	WoodHeart: {
		Tooltip: ""
		DisplayName: Wood Heart
		Lore: Where it all begins, a sturdy knot of timber chopped before you owned anything sharper than ambition. This heart thumps with a rustic, honest simplicity, blissfully unaware of what's coming. Humble, foundational, and quietly proud to be your very first.
	}

	SunplateHeart: {
		Tooltip: ""
		DisplayName: Sunplate Heart
		Lore: Salvaged from a floating island, gleaming gold and warm with high-altitude smugness. This heart beats with a bright, divine glow, certain it is better than the ground-dwellers below. Radiant, lofty, and a little too pleased with the view.
	}

	StoneHeart: {
		Tooltip: ""
		DisplayName: Stone Heart
		Lore: Yes, it is a heart made of solid rock, and yes, you are about to consume it like that is a thing people do. It beats with the slow, unbothered patience of the caverns, completely at peace with the strange life it was handed. Few hearts are this dependable, and none this content with their fate.
	}

	SpookyHeart: {
		Tooltip: ""
		DisplayName: Spooky Heart
		Lore: Carved from spooky wood on exactly the kind of night the Pumpkin Moon shows up for. This heart twitches more than it beats, restless with leftover spirit energy and distant cackling. Creepy, festive, and absolutely loving the atmosphere.
	}

	SnowHeart: {
		Tooltip: ""
		DisplayName: Snow Heart
		Lore: Packed tight from fresh snow, cool in the hand and glittering like it already knows it won't last. This heart beats with a soft, fleeting chill, here for a good time rather than a long one. Delicate, sparkling, and quietly making the most of it.
	}

	SnowCloudHeart: {
		Tooltip: ""
		DisplayName: Snow Cloud Heart
		Lore: A low gray cloud that decided to snow instead of rain and then committed fully to the bit. This heart beats with a gentle drift, shaking a few flakes loose each time it does. Soft, serene, and the calmest weather you'll ever swallow.
	}

	SlimeHeart: {
		Tooltip: ""
		DisplayName: Slime Heart
		Lore: A gooey little heart forever scooting toward other slimes, the most basic foe in the world given a pulse. It jiggles its beat with a cheerful, lonely wobble, desperate to merge with its sticky brethren. Bouncy, harmless, and bursting with more personality than substance.
	}

	ShadewoodHeart: {
		Tooltip: ""
		DisplayName: Shadewood Heart
		Lore: The Crimson's idea of a tree, dark and faintly bleeding in a way no honest plant should. This heart beats with a low, tortured groan, twisted out of timber that used to be perfectly ordinary. Grim, gnarled, and quietly resentful about the whole arrangement.
	}

	SandHeart: {
		Tooltip: ""
		DisplayName: Sand Heart
		Lore: Shifting, grinding grains that hold the dry heat of the desert and absolutely none of its water. This heart beats with a gritty, restless hiss, surviving cheerfully where softer things give up. Coarse, sun-baked, and tougher than a pile of loose sand has any right to be.
	}

	RichMahoganyHeart: {
		Tooltip: ""
		DisplayName: Rich Mahogany Heart
		Lore: Deep red timber from the underground jungle, where even the trees somehow smell expensive. This heart beats with a wild, verdant thump hauled out of the most untamed thickets around. Lush, exotic, and faintly showing off about its grain.
	}

	RedIceHeart: {
		Tooltip: ""
		DisplayName: Red Ice Heart
		Lore: Ice that soaked up the Crimson and came out looking like a crime scene. This heart beats with a vicious, predatory chill, frozen and bloodthirsty at the very same time. Frosty, menacing, and weirdly festive about it all.
	}

	RainCloudHeart: {
		Tooltip: ""
		DisplayName: Rain Cloud Heart
		Lore: A heavy gray cloud that never stops drizzling and never once apologizes for it. This heart beats with a slow, weepy patter, gloomy in a strangely refreshing way. Damp, melancholic, and the heart most likely to ruin a picnic.
	}

	RainbowHeart: {
		Tooltip: ""
		DisplayName: Rainbow Heart
		Lore: A spray of every color at once, the cheerful reward for surviving a good rainstorm. This heart beats with a lively, bouncing flicker that flatly refuses to be in a bad mood. Vivid, playful, and proud to be the happiest heart in the box.
	}

	PurpleIceHeart: {
		Tooltip: ""
		DisplayName: Purple Ice Heart
		Lore: Corrupted frost so cold it bites back, jagged and faintly menacing in the hand. This heart beats with a chilling whisper, more haunted cave than winter wonderland. Frozen, sinister, and telling you ghost stories you never asked for.
	}

	PumpkinHeart: {
		Tooltip: ""
		DisplayName: Pumpkin Heart
		Lore: Carved into a grinning heart on a crisp autumn night, flickering like a jack-o'-lantern with opinions. This heart beats with a warm candlelit glow and the faint smell of pie left out a little too long. Spooky, cozy, and grinning at a joke it refuses to share.
	}

	PinkIceHeart: {
		Tooltip: ""
		DisplayName: Pink Ice Heart
		Lore: Frozen under the Hallow's glow until it turned an aggressively cheerful shade of pink. This heart beats with a tinkling music-box chime that echoes through crystal caves. Frosty, magical, and far too pretty to take entirely seriously.
	}

	PearlwoodHeart: {
		Tooltip: ""
		DisplayName: Pearlwood Heart
		Lore: What happens when the Hallow gets ahold of an honest tree and repaints it in rainbow. This heart beats with a shimmering, faintly unnatural glow that's a touch too cheerful to fully trust. Beautiful, gleaming, and clearly up to something wholesome.
	}

	PearlstoneHeart: {
		Tooltip: ""
		DisplayName: Pearlstone Heart
		Lore: Hallowed stone that takes cleansing the world extremely personally. This heart beats with an aggressive, blinding purity, the zealot of the entire rock family. Radiant, righteous, and genuinely not interested in your shadows.
	}

	PearlsandHeart: {
		Tooltip: ""
		DisplayName: Pearlsand Heart
		Lore: Hallowed sand that purifies whatever it drifts across, humming a tiny crystalline tune the entire time. This heart beats with a soft, shimmering glow, sweetly insistent on everyone's salvation. Bright, melodic, and gently bossy about purity.
	}

	PalmWoodHeart: {
		Tooltip: ""
		DisplayName: Palm Wood Heart
		Lore: Timber from the beachside palms, carrying salt air and a permanent vacation mindset. This heart beats in slow, swaying time with the tide, in absolutely no rush. Breezy, tropical, and the single most relaxed heart in the collection.
	}

	ObsidianHeart: {
		Tooltip: ""
		DisplayName: Obsidian Heart
		Lore: Born the instant water hits lava, jagged and glassy and faintly proud of the dramatic origin story. This heart beats with a dense, smoldering warmth, dark on the outside and hot underneath. Sharp, volcanic, and considerably cooler than it acts.
	}

	MushroomHeart: {
		Tooltip: ""
		DisplayName: Mushroom Heart
		Lore: A spongy pale cap from the underground, smelling strongly of damp soil and questionable decisions. This heart beats with a soft, earthy squish, weirdly resilient for something this squishy. Fungal, humble, and thriving exactly where the sun gave up.
	}

	MudHeart: {
		Tooltip: ""
		DisplayName: Mud Heart
		Lore: Slick, heavy, and dripping with the humid lifeblood of the jungle floor. This heart beats with a primal squelch, the least glamorous and most honest sound a heart can make. Muddy, untamed, and entirely unbothered by the mess.
	}

	MarbleHeart: {
		Tooltip: ""
		DisplayName: Marble Heart
		Lore: Smooth white stone echoing with the faded grandeur of underground ruins nobody remembers building. This heart beats with a hollow, elegant ring, statuesque to the point of showing off. Polished, ancient, and forever posing for a bust it'll never get.
	}

	LesionHeart: {
		Tooltip: ""
		DisplayName: Lesion Heart
		Lore: An infected lump of the Corruption's leftovers, oozing a purple it would be wise never to touch. This heart twitches more than it beats, gross in a deeply committed way. Putrid, spasming, and somehow content with its lot in life.
	}

	IceHeart: {
		Tooltip: ""
		DisplayName: Ice Heart
		Lore: Frozen solid clear through, chilling the air just by sitting quietly in your hand. This heart beats with a slow crystalline chime and the pristine silence of the deep tundra. Cold, quiet, and entirely unbothered by your shivering.
	}

	HoneyHeart: {
		Tooltip: ""
		DisplayName: Honey Heart
		Lore: Pure jungle nectar slow-cooked into a heart by the relentless overtime of the local bees. This heart beats slow and sweet, sticky enough to make swallowing a genuine commitment. Golden, soothing, and absolutely worth thanking the hive for.
	}

	HayHeart: {
		Tooltip: ""
		DisplayName: Hay Heart
		Lore: Bundled dried stalks tied into a heart, light as a lazy afternoon and twice as rustic. This heart beats with a soft, pastoral rustle, dreaming of barns and sunny harvests. Humble, cozy, and the most flammable thing you'll ever cherish.
	}

	GraniteHeart: {
		Tooltip: ""
		DisplayName: Granite Heart
		Lore: Hewn from the strange geometric depths where the caverns suddenly get tasteful. This heart beats with a heavy, polished thrum, humming under the weight of a mile of stone overhead. Dark, angular, and quietly the classiest rock down there.
	}

	GlassHeart: {
		Tooltip: ""
		DisplayName: Glass Heart
		Lore: Spun from desert sand and furnace fire, fragile and transparent and somehow still glowing warm. This heart beats with a clear, delicate shimmer, one bad bump from a very poetic end. See-through, surprising, and braver than it looks.
	}

	FossilHeart: {
		Tooltip: ""
		DisplayName: Fossil Heart
		Lore: Ancient bones pulled from the desert, holding the echo of leviathans extinct long before you swung a pickaxe. This heart beats with a slow, calcified thud, patient the way only the truly old ever are. Prehistoric, dusty, and quietly the most experienced heart here.
	}

	FleshHeart: {
		Tooltip: ""
		DisplayName: Flesh Heart
		Lore: A grotesque slab of meat and sinew peeled from the Crimson's depths, exactly as charming as it sounds. This heart beats with a disturbing wet squelch, refreshingly literal about being an actual heart. Visceral, dripping, and oddly proud of the honesty.
	}

	EbonwoodHeart: {
		Tooltip: ""
		DisplayName: Ebonwood Heart
		Lore: The Corruption's take on trees, twisted and gnarled and faintly upset about existing. This heart beats with a dark, festering pulse, nature's own cautionary tale. Grim, warped, and quietly sure it used to be something nicer.
	}

	EbonstoneHeart: {
		Tooltip: ""
		DisplayName: Ebonstone Heart
		Lore: Cold purple rock from the Corruption, the kind that spreads the instant you glance away. This heart beats with a relentless, creeping malice, eager to paint the whole map its color. Stubborn, sinister, and never once satisfied with the territory it has.
	}

	EbonsandHeart: {
		Tooltip: ""
		DisplayName: Ebonsand Heart
		Lore: Dark grit from the corrupt desert, whispering decay one suffocating grain at a time. This heart beats with a low, gritty hiss, plotting something it won't fully explain. Bleak, parched, and far too chatty about the end of things.
	}

	DynastyHeart: {
		Tooltip: ""
		DisplayName: Dynasty Heart
		Lore: Built with the refined elegance of a long-lost eastern empire, all clean lines and quiet wisdom. This heart beats with a poised, architectural calm, classier than most of its neighbors. Graceful, ornate, and certain that good taste never goes out of style.
	}

	DirtHeart: {
		Tooltip: ""
		DisplayName: Dirt Heart
		Lore: Of all the hearts you will solemnly devour, none is humbler or more honest than a clump of dirt that learned to beat. It pulses with the patient rhythm of the ground that props up everyone too important to notice it. You will eat it anyway, and somehow that feels exactly right.
	}

	CrimstoneHeart: {
		Tooltip: ""
		DisplayName: Crimstone Heart
		Lore: A fleshy chunk of the Crimson's core, throbbing in a way stone really should not. This heart beats with a sickly, meaty rhythm, more open wound than honest mineral. Visceral, ominous, and far too warm for a rock.
	}

	CrimsandHeart: {
		Tooltip: ""
		DisplayName: Crimsand Heart
		Lore: Blood-stained grains from the Crimson desert, scraping together with a thirst they can't shake. This heart beats with a parasitic, gritty hiss, hungry the way only sand somehow manages. Crimson, coarse, and unsettlingly eager.
	}

	CoralstoneHeart: {
		Tooltip: ""
		DisplayName: Coralstone Heart
		Lore: Grown in the bright shallows where the ocean keeps its prettiest rocks. This heart beats with the soft crash of distant waves, holding the sea's lifeblood inside a stone. Vibrant, salty, and humming with a faraway tide.
	}

	CloudHeart: {
		Tooltip: ""
		DisplayName: Cloud Heart
		Lore: Light as a feather and forever drifting, basically a piece of sky that decided to grow a pulse. This heart beats with a gentle high-altitude breeze, threatening to float off the moment you blink. Airy, weightless, and barely tethered to the conversation.
	}

	CandyCaneHeart: {
		Tooltip: ""
		DisplayName: Candy Cane Heart
		Lore: Festively striped and reeking of peppermint, sugary enough to worry a dentist from across the room. This heart beats with a hyperactive sugar-rush rhythm, all holiday cheer and zero chill. Sweet, jittery, and absolutely vibrating with joy.
	}

	CactusHeart: {
		Tooltip: ""
		DisplayName: Cactus Heart
		Lore: Prickly outside, surprisingly juicy inside, and stubborn enough to thrive where nothing else bothers. This heart beats with a tough, water-hoarding rhythm honed by the harsh desert. Spiky, resilient, and proud of surviving on pure spite.
	}

	BubbleHeart: {
		Tooltip: ""
		DisplayName: Bubble Heart
		Lore: A delicate, iridescent heart so buoyant it seems faintly embarrassed to be held down. This heart beats with a soft, weightless shimmer, ready to drift off the instant you exhale. Fragile, shiny, and living entirely in the moment.
	}

	BorealWoodHeart: {
		Tooltip: ""
		DisplayName: Boreal Wood Heart
		Lore: Pine timber from the snow biome, smelling of fresh frost and quiet resilience. This heart beats with a cool, hardy thump, used to weather that would flatten softer wood. Chilly, sturdy, and completely unbothered by the cold.
	}

	ZephyrHeart: {
		Tooltip: ""
		DisplayName: Zephyr Heart
		Lore: Practically weightless, dancing on the high winds like gravity is somebody else's problem. This heart beats with a swift, unburdened flutter, all open sky and no baggage. Light, free, and quietly daring you to keep up.
	}

	YewWoodHeart: {
		Tooltip: ""
		DisplayName: Yew Wood Heart
		Lore: Carved from a poisonous tree that stays beautiful right up until it absolutely isn't. This heart beats with a toxic but enduring rhythm, the deadly elegance of an old forest. Lovely, lethal, and entirely aware of the contrast.
	}

	VampireHeart: {
		Tooltip: ""
		DisplayName: Vampire Heart
		Lore: A heart that craves other hearts, which is ironic enough to sit with for a moment. Cold, thirsty, and fully on theme, it only beats when there's blood nearby and sulks when there isn't. The Crimson would be proud; your cardiologist would not.
	}

	ValadiumHeart: {
		Tooltip: ""
		DisplayName: Valadium Heart
		Lore: A gravity-optional stone that beats with an unsettling lightness, never fully committed to this dimension. This heart pulses with unstable starlit energy, bending the space around it just to show off. Otherworldly, weightless, and a little smug about physics.
	}

	ThoriumHeart: {
		Tooltip: ""
		DisplayName: Thorium Heart
		Lore: A crystalline ore humming with strange, faintly radioactive ambition. This heart beats with a slow, heavy, transformative resonance, quietly rewriting whatever it touches. Glowing, peculiar, and proud to be the element everything else got named after.
	}

	StormHeart: {
		Tooltip: ""
		DisplayName: Storm Heart
		Lore: Crackling with a thunderhead's worst mood, bottled into a heart that flatly refuses to settle. This heart beats in jagged bursts of lightning, loud enough to make the others nervous. Electric, volatile, and showing off at every chance it gets.
	}

	SmoothCoalHeart: {
		Tooltip: ""
		DisplayName: Smooth Coal Heart
		Lore: A dense black lump hiding a slow, patient heat that simply won't quit. This heart beats with the steady endurance of fuel built to burn all night. Humble, warm, and quietly the most reliable thing in the furnace.
	}

	SeaBreezeHeart: {
		Tooltip: ""
		DisplayName: Sea Breeze Heart
		Lore: A light, airy heart carrying salt spray and the smell of a flawless beach day. This heart beats with a carefree, liberating flutter, allergic to stress of any kind. Breezy, refreshing, and on permanent holiday.
	}

	PermafrostHeart: {
		Tooltip: ""
		DisplayName: Permafrost Heart
		Lore: Ice so old it forgot how to melt, radiating a flat absolute-zero attitude. This heart beats with the relentless harshness of an endless winter, charming as a glacier. Frozen, severe, and proud of never once thawing.
	}

	PearlHeart: {
		Tooltip: ""
		DisplayName: Pearl Heart
		Lore: A smooth, lustrous treasure plucked from the deep ocean, calm and faintly self-satisfied. This heart beats with a serene, pure rhythm, the unblemished beauty of something that took years to form. Precious, tranquil, and well worth the dive.
	}

	OpalHeart: {
		Tooltip: ""
		DisplayName: Opal Heart
		Lore: A gem that can't pick a color, flashing through the whole spectrum like it's indecisive on purpose. This heart beats with a chaotic, beautiful shimmer, magic with the volume left way up. Mesmerizing, restless, and impossible to look away from.
	}

	OnyxHeart: {
		Tooltip: ""
		DisplayName: Onyx Heart
		Lore: Pitch-black and light-devouring, dressed for a funeral it is clearly enjoying. This heart beats with cold, calculating precision, the most sophisticated stone in the dark. Sleek, ruthless, and effortlessly the room's villain.
	}

	OmegaHeart: {
		Tooltip: ""
		DisplayName: Omega Heart
		Lore: A high-tech core humming with the menace of something built to end things efficiently. This heart beats with a synthetic, intimidating rhythm, more apocalypse than anatomy. Mechanical, ominous, and disturbingly well-engineered.
	}

	MossyMarineRockHeart: {
		Tooltip: ""
		DisplayName: Mossy Marine Rock Heart
		Lore: A seabed stone wearing a thick coat of deep-ocean greenery, calm as an underwater garden. This heart beats with a tranquil, mossy hum, soothing in a way rocks rarely manage. Quiet, verdant, and at total peace down there.
	}

	MagmaHeart: {
		Tooltip: ""
		DisplayName: Magma Heart
		Lore: Half-melted and churning, basically lava that hasn't decided whether to be solid yet. This heart beats with a bubbling, volcanic roar, furious and gloriously unstable. Molten, chaotic, and a serious hazard to upholstery.
	}

	LodestoneHeart: {
		Tooltip: ""
		DisplayName: Lodestone Heart
		Lore: A heavy magnetic core humming with a field strong enough to ruin your compass. This heart beats with a polarizing pull, dragging stray vitality in and refusing to share. Dense, magnetic, and quietly clingy.
	}

	LifeQuartzHeart: {
		Tooltip: ""
		DisplayName: Life Quartz Heart
		Lore: A translucent crystal that amplifies whatever life force happens to wander too near. This heart beats in perfect time with the world itself, pure and faintly humming. Luminous, vital, and quietly plugged into something much bigger.
	}

	LichHeart: {
		Tooltip: ""
		DisplayName: Lich Heart
		Lore: A phylactery of flesh beating with the cold necrotic rhythm of something that refuses to stay dead. This heart hums with forbidden secrets about cheating the grave, and it's a little smug about knowing them. Undead, calculating, and in no danger of expiring.
	}

	IllumiteHeart: {
		Tooltip: ""
		DisplayName: Illumite Heart
		Lore: A radiant ore that throws warm, soothing light into the darkest corners around. This heart beats with a harmonious glow, the kind that makes shadows quietly excuse themselves. Bright, gentle, and the most welcome thing in a black cave.
	}

	IceboundStriderHeart: {
		Tooltip: ""
		DisplayName: Icebound Strider Heart
		Lore: Frozen straight from the tundra's apex predator, all blizzard and bad intentions. This heart beats with a piercing, untamed chill, wild the way only a winter hunter ever is. Crystalline, fierce, and faintly snarling.
	}

	DormantHeart: {
		Tooltip: ""
		DisplayName: Dormant Heart
		Lore: A cold, lifeless-looking stone hiding the faintest heartbeat, just waiting for an excuse. This heart beats so quietly you'd miss it, patient for the catalyst that finally wakes it. Sleepy, secretive, and saving its best for later.
	}

	DepthsRockHeart: {
		Tooltip: ""
		DisplayName: Depths Rock Heart
		Lore: Jagged stone from the crushing deep, where the silence is heavy and the pressure is honest. This heart beats with an enduring, stoic strength, calm under a mountain of weight. Sturdy, solemn, and entirely unimpressed by your problems.
	}

	ChampionHeart: {
		Tooltip: ""
		DisplayName: Champion Heart
		Lore: Forged from the triumphant spirit of a grand tournament's last one standing. This heart beats with pure pride and determination, the glow of someone who flatly refused to lose. Radiant, victorious, and absolutely here to gloat.
	}

	BrackishClumpHeart: {
		Tooltip: ""
		DisplayName: Brackish Clump Heart
		Lore: A murky algae-caked lump from waters that haven't moved in years and smell like it. This heart beats slow and swampy, somehow bursting with life despite the salt and the decay. Gross, stagnant, and thriving anyway out of pure stubbornness.
	}

	BeholderHeart: {
		Tooltip: ""
		DisplayName: Beholder Heart
		Lore: A fleshy heart with the distinct sense that it is quietly watching you back. It throbs with chaotic magic from somewhere past the stars, eyeless yet deeply nosy. Grotesque, alert, and absolutely judging your build.
	}

	AquaiteHeart: {
		Tooltip: ""
		DisplayName: Aquaite Heart
		Lore: A pristine watery core that flows in a constant, soothing, liquid rhythm. This heart beats clean and clear, the uncorrupted essence of everything that swims. Refreshing, calm, and the most hydrated heart around.
	}

	AbyssalHeart: {
		Tooltip: ""
		DisplayName: Abyssal Heart
		Lore: Dredged from the crushing deep, where sunlight gives up and the pressure absolutely does not. This heart beats slow to the rhythm of abyssal currents, carrying the whole ocean's weight. Heavy, dark, and quietly enormous.
	}

	SoulOfBlightHeart: {
		Tooltip: ""
		DisplayName: Soul Of Blight Heart
		Lore: A fractured shard of pure disease, pulsing with an aura that ruins the air around it. This heart beats with a virulent, sickening rhythm, an ancient plague packed into one bad idea. Toxic, ominous, and best handled with gloves.
	}

	EasterHeart: {
		Tooltip: ""
		DisplayName: Easter Heart
		Lore: A pastel heart radiating springtime cheer and the suspicious energy of a holiday rabbit. This heart beats with playful, renewing warmth, bright as a sunny April morning. Cheerful, colorful, and hiding eggs somewhere on principle.
	}

	CursedHeart: {
		Tooltip: ""
		DisplayName: Cursed Heart
		Lore: Wrapped in mystical bindings that exist mostly to keep something contained. This heart beats with a sinister, malevolent rhythm, eager to introduce you to a few forgotten spirits. Ominous, bound, and frankly not a great houseguest.
	}

	CornucopiaHeart: {
		Tooltip: ""
		DisplayName: Cornucopia Heart
		Lore: Overflowing with festive plenty, the heart equivalent of a table that simply won't stop refilling. This heart beats with a warm, generous thrum, promising endless feasts to anyone nearby. Abundant, cozy, and impossible to leave hungry.
	}

	VoidstoneHeart: {
		Tooltip: ""
		DisplayName: Voidstone Heart
		Lore: Compressed nothingness given a pulse, dense enough to make gravity itself nervous. This heart beats with a pull that tugs at the soul, quietly insisting on the void. Cold, heavy, and politely trying to swallow you.
	}

	UelibloomHeart: {
		Tooltip: ""
		DisplayName: Uelibloom Heart
		Lore: Tangled in prolific jungle flora, blooming so hard it borders on aggressive. This heart beats with rampant life energy, nature briskly reclaiming whatever you weren't using. Verdant, relentless, and overgrowing as we speak.
	}

	TwistingHeart: {
		Tooltip: ""
		DisplayName: Twisting Heart
		Lore: A heart from somewhere deeply wrong, writhing and contorting like it can't agree on a shape. It beats with a chaotic, unnatural rhythm, twisting on its own the moment you look away. Grotesque, restless, and faintly nauseating to watch.
	}

	TenebrisHeart: {
		Tooltip: ""
		DisplayName: Tenebris Heart
		Lore: Carved from abyssal dark so deep it eats light for fun. This heart beats with a chilling void, whispering about the lightless trenches where leviathans sleep. Black, cold, and dropping ominous hints.
	}

	SulphurousSandstoneHeart: {
		Tooltip: ""
		DisplayName: Sulphurous Sandstone Heart
		Lore: Porous rock hardened by acidic tides, holding the bitter memory of a ruined coastline. This heart beats with a low hum, mourning an ecosystem that didn't survive the chemistry. Crumbling, sour, and stubbornly nostalgic.
	}

	SulphurousSandHeart: {
		Tooltip: ""
		DisplayName: Sulphurous Sand Heart
		Lore: Toxic dunes from the sulphurous sea, steadily weeping a brine you really should not touch. This heart beats with a sluggish, sickening rhythm, corrosive and quietly proud of it. Acidic, grim, and an active workplace hazard.
	}

	SeaPrismHeart: {
		Tooltip: ""
		DisplayName: Sea Prism Heart
		Lore: A crystallized shard of the sunken sea, glimmering with soft aquatic light. This heart beats in time with ancient ocean tides, gentle and faintly glowing. Luminous, serene, and quietly humming an old sea shanty.
	}

	ScoriaHeart: {
		Tooltip: ""
		DisplayName: Scoria Heart
		Lore: Forged in the abyss's fiery floor, where the ocean somehow learned to catch fire. This heart beats with intense geothermal heat, scalding enough to test whether you're worthy. Molten, oceanic, and a contradiction it fully enjoys.
	}

	RottenHeart: {
		Tooltip: ""
		DisplayName: Rotten Heart
		Lore: A decaying, foul-smelling clump of corrupt flesh held together by spite and dark magic. This heart beats feebly, running entirely on fumes and bad intentions. Putrid, fragile, and refusing to quit on principle.
	}

	ProfanedHeart: {
		Tooltip: ""
		DisplayName: Profaned Heart
		Lore: A sacred core that unholy flames got to first, holy and damned in one uncomfortable package. This heart beats with a burning, awful awe, radiating light that forgives absolutely nothing. Radiant, corrupted, and intimidating from every angle.
	}

	PolarizedHeart: {
		Tooltip: ""
		DisplayName: Polarized Heart
		Lore: A magnetic core that can't stop flip-flopping between two opposite energies. This heart beats in unpredictable, crackling bursts, charged and faintly dangerous. Volatile, indecisive, and one polarity swap from chaos.
	}

	PlantyMushHeart: {
		Tooltip: ""
		DisplayName: Planty Mush Heart
		Lore: A cozy symbiosis of jungle plant and underground fungus that simply decided to team up. This heart pulses softly, breathing out an earthy, revitalizing smell. Green, mushy, and the most wholesome roommate situation around.
	}

	PerennialHeart: {
		Tooltip: ""
		DisplayName: Perennial Heart
		Lore: An overgrown heart that sprouts fresh vines every time it beats, never quite knowing when to stop. It pulses with the jungle's unstoppable regenerative streak, greener by the second. Lush, relentless, and quietly redecorating your inventory.
	}

	OceanHeart: {
		Tooltip: ""
		DisplayName: Ocean Heart
		Lore: A vibrant watery core smelling of salt, sunscreen, and one excellent summer. This heart beats with the bountiful life of the open sea, deep and endless and cheerful. Refreshing, vast, and basically a vacation in heart form.
	}

	NovaeSlugHeart: {
		Tooltip: ""
		DisplayName: Novae Slug Heart
		Lore: A soft, radiant organ that once powered a little star-forged creature minding its own business. This heart beats with a warm, comforting cosmic glow, gentle as a nightlight. Squishy, luminous, and weirdly soothing for something from space.
	}

	NebulousHeart: {
		Tooltip: ""
		DisplayName: Nebulous Heart
		Lore: A whole galaxy crammed into heart shape, because the universe can never resist a heart-shaped thing. This heart beats with swirling stardust, offering a quick peek at how everything began. Cosmic, delicate, and far too big for its container.
	}

	NavystoneHeart: {
		Tooltip: ""
		DisplayName: Navystone Heart
		Lore: A smooth oceanic stone steeped in the quiet magic of the deep abyss. This heart beats with an ancient, patient power dredged from far beneath the waves. Dark, weighty, and old enough to remember the first tide.
	}

	MutatedHeart: {
		Tooltip: ""
		DisplayName: Mutated Heart
		Lore: A grotesque organ warped by forces that clearly never read the manual. This heart beats irregularly, shifting shape and breaking natural laws as a hobby. Unstable, uncanny, and never quite the same twice.
	}

	HardenedAstralSandHeart: {
		Tooltip: ""
		DisplayName: Hardened Astral Sand Heart
		Lore: Petrified sand fused solid in the heat of an astral impact, heavy with cosmic baggage. This heart beats with a slow, weighty thrum, secretive about whatever it watched fall. Dense, alien, and keeping the universe's secrets to itself.
	}

	GravistarHeart: {
		Tooltip: ""
		DisplayName: Gravistar Heart
		Lore: A dense little core warping gravity hard enough to drag everything nearby toward it. This heart beats to the relentless rhythm of a dying star, pulling and pulling and pulling. Heavy, magnetic, and the center of attention by force.
	}

	GehennaHeart: {
		Tooltip: ""
		DisplayName: Gehenna Heart
		Lore: A burning relic dredged from the underworld's least pleasant basement. This heart beats with a silent scream, smoldering with the agony of the damned. Hellish, ominous, and not remotely in a sharing mood.
	}

	FungalHeart: {
		Tooltip: ""
		DisplayName: Fungal Heart
		Lore: A glowing spongy mass thoroughly colonized by the mushroom biome, and clearly thriving for it. This heart puffs out a cloud of luminescent spores each time it beats, lighting up the dark. Luminous, infectious, and proud of its bloom.
	}

	ExodiumClusterHeart: {
		Tooltip: ""
		DisplayName: Exodium Cluster Heart
		Lore: A jagged clump of space ores that somehow grew a heartbeat against everyone's advice. This heart pulses while drinking in ambient energy like a small, hungry black hole. Cosmic, greedy, and running entirely on audacity.
	}

	EutrophicSandHeart: {
		Tooltip: ""
		DisplayName: Eutrophic Sand Heart
		Lore: Bright crystal-veined sand hidden in the depths of the Sunken Sea. This heart beats with a soothing aquatic calm, glowing softly in the dark water. Luminous, tranquil, and quietly the prettiest thing down there.
	}

	DynamoStemHeart: {
		Tooltip: ""
		DisplayName: Dynamo Stem Heart
		Lore: Part plant, part machine, humming with electricity it grows entirely by itself. This heart beats where nature and engineering shook hands and agreed to collaborate. Botanical, electric, and weirdly ahead of its time.
	}

	DraconicHeart: {
		Tooltip: ""
		DisplayName: Draconic Heart
		Lore: A massive scaly heart pried from the remains of a mythical wyrm, still smoldering with ego. This heart beats with the ancient might of dragons, certain it could roast you on principle. Huge, fierce, and a legend in its own mind.
	}

	DarkPlasmicHeart: {
		Tooltip: ""
		DisplayName: Dark Plasmic Heart
		Lore: A volatile orb of dark energy that bends light away from itself just to be dramatic. This heart writhes more than it beats, packed with shadowy forces itching to get out. Unstable, ominous, and one bad day from a tantrum.
	}

	CrystallizedToxicHeart: {
		Tooltip: ""
		DisplayName: Crystallized Toxic Heart
		Lore: A brittle radioactive organ glowing the exact shade of green that means run. This heart throbs with the concentrated malice of a corrosive wasteland, proud of every last rad. Toxic, glowing, and in no way food-safe.
	}

	CryonicHeart: {
		Tooltip: ""
		DisplayName: Cryonic Heart
		Lore: Magical ice from the tundra's depths that flatly refuses to melt, no matter how nicely you ask. This heart beats with a freezing serenity, calm and cold and oddly meditative. Frosty, peaceful, and the chillest heart in every sense.
	}

	CryogenHeart: {
		Tooltip: ""
		DisplayName: Cryogen Heart
		Lore: A jagged frost crystal that once kept a great power locked up nice and cold. This heart beats in biting icy pulses that send a shiver clean down your spine. Sharp, frozen, and clearly used to holding things down.
	}

	CosmiliteHeart: {
		Tooltip: ""
		DisplayName: Cosmilite Heart
		Lore: A sleek, indestructible core forged from an alloy that ate a god and didn't blink. This heart beats with an intimidating high-frequency hum, smug about being unbreakable. Cosmic, flawless, and quietly the toughest thing in the box.
	}

	CorpusHeart: {
		Tooltip: ""
		DisplayName: Corpus Heart
		Lore: A horrifying mash of bloody tissue and sinew, pulsing with cheerfully morbid vitality. This heart beats as a grim reminder that the Crimson never, ever stops growing. Visceral, ominous, and far too lively for comfort.
	}

	CinderplateHeart: {
		Tooltip: ""
		DisplayName: Cinderplate Heart
		Lore: A jagged metal heart seared black by volcanic heat and ash. This heart crunches like hot coals with every slow beat, smelling faintly of campfire. Charred, dense, and still slowly cooling off.
	}

	CelestialRemainsHeart: {
		Tooltip: ""
		DisplayName: Celestial Remains Heart
		Lore: A solemn relic left behind once the lunar apocalypse packed up and went home. This heart beats into an eerie silence, echoing the quiet that comes after the cosmos. Hushed, ancient, and heavy with the end of something.
	}

	CalamitousHeart: {
		Tooltip: ""
		DisplayName: Calamitous Heart
		Lore: A volatile artifact born of pure destruction, radiating the specific dread of a very bad omen. This heart beats with catastrophic energy, handing out visions of the world's end at no charge. Terrifying, unstable, and best respected from a distance.
	}

	BrimstoneSlagHeart: {
		Tooltip: ""
		DisplayName: Brimstone Slag Heart
		Lore: Forged in the ruined fiery crags where the air itself seems to hold a grudge. This heart beats with a hellish heat, smelling permanently of sulfur and ash. Scorching, grim, and not the least bit interested in cooling down.
	}

	BloodyWormHeart: {
		Tooltip: ""
		DisplayName: Bloody Worm Heart
		Lore: A fleshy lump torn from an enormous blood-red worm, still squirming for one more bite. This heart beats with a wet, desperate hunger, eager to consume anything within reach. Gross, restless, and refreshingly honest about its appetite.
	}

	BlazingHeart: {
		Tooltip: ""
		DisplayName: Blazing Heart
		Lore: A searing core of concentrated fire that threatens to melt whatever it leans against. This heart beats with the eternal roaring fury of the underworld, subtlety not included. Molten, loud, and a guaranteed fire hazard.
	}

	AuricHeart: {
		Tooltip: ""
		DisplayName: Auric Heart
		Lore: A divine core shimmering with so much golden power it borders on showing off. This heart beats with a god's boundless lifeforce, radiant enough to make the sun a little jealous. Holy, dazzling, and absolutely top of the food chain.
	}

	AstralStoneHeart: {
		Tooltip: ""
		DisplayName: Astral Stone Heart
		Lore: Hewn from cosmic bedrock that is older than the ground you happen to be standing on. This heart beats heavy enough to rumble the floor, eternal and entirely unbothered. Ancient, weighty, and quietly immovable.
	}

	AstralSnowHeart: {
		Tooltip: ""
		DisplayName: Astral Snow Heart
		Lore: Delicate frozen fallout from an astral collision, cold in a way snow really shouldn't be. This heart beats with a silent melody of the frozen void, soft and faintly alien. Icy, gentle, and humming a tune from nowhere.
	}

	AstralSandstoneHeart: {
		Tooltip: ""
		DisplayName: Astral Sandstone Heart
		Lore: Compressed by cosmic radiation and a great many eons into a blindingly starry stone. This heart beats with the contained fury of a shooting star, shining like it never actually landed. Lustrous, dense, and dramatically overqualified.
	}

	AstralSandHeart: {
		Tooltip: ""
		DisplayName: Astral Sand Heart
		Lore: Shifting crystalline grains from a star-blasted desert that flow forever yet never fall apart. This heart beats while constantly pouring, somehow keeping its shape out of pure stubbornness. Restless, cosmic, and quietly impossible.
	}

	AstralMonolithHeart: {
		Tooltip: ""
		DisplayName: Astral Monolith Heart
		Lore: A heavy slab of stone doubling as a beacon for the astral infection, which is rarely good news. This heart throbs with a slow, ancient, faintly terrifying rhythm. Monolithic, ominous, and signaling something you'd rather not meet.
	}

	AstralIceHeart: {
		Tooltip: ""
		DisplayName: Astral Ice Heart
		Lore: Frozen solid by the absolute-zero temperatures of deep space, where warmth is just a rumor. This heart beats with a chilling aura that slows the blood of anyone who drifts near. Glacial, eerie, and colder than the void itself.
	}

	AstralHeart: {
		Tooltip: ""
		DisplayName: Astral Heart
		Lore: A purple shard that caught a ride on a meteor and still hums a tune from a galaxy you'll never see. This heart beats with the eerie glow of the astral blight, carrying the weight of a thousand dying stars. Cosmic, radiant, and a little homesick for space.
	}

	AstralDirtHeart: {
		Tooltip: ""
		DisplayName: Astral Dirt Heart
		Lore: Ordinary dirt that had a meteor land on it and never recovered, in the best possible way. This heart beats steadily while shedding little flecks of stardust everywhere it goes. Humble, cosmic, and the most upgraded soil you'll ever meet.
	}

	AstralClayHeart: {
		Tooltip: ""
		DisplayName: Astral Clay Heart
		Lore: Alien soil from a fallen star, pliable as fresh clay yet stubbornly impossible to wear out. This heart beats with the silent whispers of the cosmos, soft to the touch and built to last. Moldable, durable, and quietly otherworldly.
	}

	AstralBossHeart: {
		Tooltip: ""
		DisplayName: Astral Boss Heart
		Lore: A majestic core salvaged from a fallen starborn entity that did not come quietly. This heart burns with the cold, unfathomable fire of the astral infection, regal even in defeat. Radiant, alien, and used to being the biggest thing around.
	}

	ArmoredHeart: {
		Tooltip: ""
		DisplayName: Armored Heart
		Lore: Sealed in a metal shell tough enough to survive blows that would crack any normal core. This heart thuds like a hammer on an anvil, perfectly safe behind its own plating. Sturdy, clanging, and quietly the best-defended heart here.
	}

	AquaticHeart: {
		Tooltip: ""
		DisplayName: Aquatic Heart
		Lore: A crystalline organ that quietly weeps fresh, pure water without ever running dry. This heart beats with the calm pull of the open sea, leaving you oddly homesick for the waves. Clear, soothing, and the most refreshing thing in the box.
	}

	AmbergrisHeart: {
		Tooltip: ""
		DisplayName: Ambergris Heart
		Lore: An aromatic clump harvested from a colossal deep-sea leviathan, surprisingly pleasant for its origin. This heart beats with the enduring vitality of the ocean's biggest predators. Strange, fragrant, and far classier than it has any right to be.
	}

	AfflictedHeart: {
		Tooltip: ""
		DisplayName: Afflicted Heart
		Lore: A sorrowful remnant carrying a dreadful curse and a glow that plainly means trouble. This heart beats with an agonizing, irregular rhythm, warning of the mutation simmering inside. Cursed, glowing, and bravely beating anyway.
	}

	AerialiteHeart: {
		Tooltip: ""
		DisplayName: Aerialite Heart
		Lore: Light as a feather and crackling with static, basically a stray piece of the open sky. This heart beats with a crisp, electric flutter, allergic to ever staying grounded. Airy, charged, and quietly itching to take off.
	}

	AbyssGravelHeart: {
		Tooltip: ""
		DisplayName: Abyss Gravel Heart
		Lore: Crushed flat under the weight of the entire ocean, cold and lightless and faintly haunted. This heart beats with a low whisper of the deep Abyss and whatever lurks in it. Dark, dense, and dropping deeply unsettling hints.
	}

	GlowingMushroomHeart: {
		DisplayName: Glowing Mushroom Heart
		Tooltip: ""
		Lore: A soft blue glowing cap smelling pleasantly of damp spores and strange dreams. This heart beats with a gentle bioluminescent pulse, lighting up its own little fungal world. Luminous, cozy, and quietly a bit trippy.
	}

	AstraHeart: {
		DisplayName: Astra Heart
		Tooltip: ""
		Lore: Gleaming with starlight borrowed from galaxies that are very, very far from here. This heart beats in quiet cosmic harmony, calm as a clear night sky. Radiant, serene, and humming along with the universe.
	}

	CosmicEmberHeart: {
		DisplayName: Cosmic Ember Heart
		Tooltip: ""
		Lore: A still-burning fragment of a dying star, warm enough to thaw the gloomiest mood. This heart beats with the eternal fire of the universe, glowing softly in your hand. Warm, radiant, and the coziest thing space ever produced.
	}

	CryocoreHeart: {
		DisplayName: Cryocore Heart
		Tooltip: ""
		Lore: Frozen solid and radiating an absolute-zero chill that numbs whatever it touches. This heart beats slowly, preserving life in a quiet icy stasis like a tiny cryo-pod. Cold, calm, and pressing pause on everything.
	}

	DarkCelestialHeart: {
		DisplayName: Dark Celestial Heart
		Tooltip: ""
		Lore: Swirling with the gravity of a black hole, dressed head to toe in cosmic dread. This heart beats while pulling worldly energy inward, fueling a quietly abyssal strength. Dark, dense, and far hungrier than it lets on.
	}

	HeavenforgeHeart: {
		DisplayName: Heavenforge Heart
		Tooltip: ""
		Lore: Forged in the celestial fires of the sky islands, where the metal comes out a little holy. This heart beats with divine heat and purity, tempered high above the clouds. Radiant, refined, and faintly looking down on the ground crew.
	}

	LunarRustHeart: {
		DisplayName: Lunar Rust Heart
		Tooltip: ""
		Lore: Corroded by the slow grind of cosmic time, weathered the way only truly ancient things get. This heart beats with the patient endurance of forgotten celestial bodies. Rusty, timeless, and proud of every scar.
	}

	MercuryHeart: {
		DisplayName: Mercury Heart
		Tooltip: ""
		Lore: A toxic liquid-metal core flowing with deadly, mesmerizing grace. This heart beats in shifting silver ripples, hardening the body against everything ordinary. Slick, poisonous, and far prettier than it is safe.
	}

	StarRoyaleHeart: {
		DisplayName: Star Royale Heart
		Tooltip: ""
		Lore: A regal concentration of fallen stars that carries itself like the night sky's chosen heir. This heart beats with majestic stellar light, certain it outranks every other heart in the room. Radiant, proud, and clearly dressed for the throne.
	}

	JungleSporeHeart: {
		DisplayName: Jungle Spore Heart
		Tooltip: ""
		Lore: Tangled in glowing vines and blooming with the toxic life of the deep jungle. This heart beats while humming the song of venomous flora, pretty and quietly poisonous. Verdant, ancient, and ironically not to be put in your mouth.
	}

	AppleHeart: {
		DisplayName: Apple Heart
		Tooltip: ""
		Lore: A heart that grew on an ordinary tree, which is somehow stranger than the magic ones. It beats with crisp, simple vitality and the faint smell of an orchard afternoon. Honest, sweet, and proof the classics still hold up.
	}

	ApricotHeart: {
		DisplayName: Apricot Heart
		Tooltip: ""
		Lore: A fuzzy golden heart that smells like the single best afternoon of summer. It beats with a quick burst of sunlit energy, warm and just a little sleepy. Soft, cheerful, and the heart most likely to nap.
	}

	BananaHeart: {
		DisplayName: Banana Heart
		Tooltip: ""
		Lore: A heart you actually peel, which is both delightful and a fair amount to process. It beats soft and sweet, instantly conjuring a beach you have never once visited. Tropical, silly, and fully committed to the bit.
	}

	BlackcurrantHeart: {
		DisplayName: Blackcurrant Heart
		Tooltip: ""
		Lore: A tart dark-berried heart picked off a wild bush nobody bothered to plant. It beats with a sharp, bracing snap that wakes up the senses on contact. Sour, bold, and genuinely proud of the pucker.
	}

	BlinkrootHeart: {
		DisplayName: Blinkroot Heart
		Tooltip: ""
		Lore: A dusty little heart that flickers on and off like it's trying to save electricity. It beats in erratic glowing pulses, perfectly at home down in the underground dirt. Flickery, humble, and quietly cagey about the timing.
	}

	BloodOrangeHeart: {
		DisplayName: Blood Orange Heart
		Tooltip: ""
		Lore: A deep red citrus heart that stains your hands like fresh evidence. It beats with a sinister yet deeply refreshing surge, juice with a slight attitude problem. Vivid, tangy, and faintly dramatic about it.
	}

	BlueHeart: {
		DisplayName: Blue Heart
		Tooltip: ""
		Lore: A mysterious azure heart, cool to the touch and reluctant to explain itself. It beats with an unknown, faintly melancholic magic, keeping its origins entirely to itself. Calm, enigmatic, and clearly going through something.
	}

	CherryHeart: {
		DisplayName: Cherry Heart
		Tooltip: ""
		Lore: A small crimson heart packing a startling amount of sweet-and-tart into one bite. It beats with a delightful sugary burst, the friendliest little jolt in the whole box. Tiny, bright, and punching well above its size.
	}

	CoconutHeart: {
		DisplayName: Coconut Heart
		Tooltip: ""
		Lore: A tough heart you have to crack open before it gives up anything at all. It beats with the stubborn, refreshing life of a coastal palm, rewarding only the persistent. Hard-headed, hydrating, and well worth the effort.
	}

	DaybloomHeart: {
		DisplayName: Daybloom Heart
		Tooltip: ""
		Lore: A sun-loving heart that only really shines while the sun is actually up. It beats with the pure, untainted energy of the surface world, drooping the moment it gets dark. Bright, cheerful, and emphatically a morning person.
	}

	DeathweedHeart: {
		DisplayName: Deathweed Heart
		Tooltip: ""
		Lore: A thorny heart that only thrives under a Blood Moon, which honestly tells you plenty. It beats with potent vitality laced with dark magic, lovely and faintly cursed. Sinister, spiky, and best harvested with real caution.
	}

	DragonFruitHeart: {
		DisplayName: Dragon Fruit Heart
		Tooltip: ""
		Lore: An exotic scaly heart with a hot pink shell and a speckled middle, dressed for attention. It beats with the taste of untamed wilds and mythical beasts, mostly the mild kind. Flashy, tropical, and named far braver than it acts.
	}

	ElderberryHeart: {
		DisplayName: Elderberry Heart
		Tooltip: ""
		Lore: A clustered heart with a deep, earthy flavor pulled straight from old-growth shade. It beats with the quiet ancient strength of forests that stood here long before you did. Robust, humble, and wiser than your average berry.
	}

	FireblossomHeart: {
		DisplayName: Fireblossom Heart
		Tooltip: ""
		Lore: A scorching flower forged in the ashes of the Underworld, blooming where nothing sensibly should. This heart beats with the relentless fury of magma, hot enough to demand respect. Fiery, stubborn, and the toughest petal in the realm.
	}

	GrapefruitHeart: {
		DisplayName: Grapefruit Heart
		Tooltip: ""
		Lore: A big bitter-sweet citrus heart that jolts the entire system awake on contact. It beats with a zesty, sharp tang, the wake-up call nobody asked for but everyone needed. Bracing, bold, and unapologetically loud.
	}

	GrapeHeart: {
		DisplayName: Grape Heart
		Tooltip: ""
		Lore: A plump juicy heart tasting of rich vineyards and orchards long forgotten. It beats with a smooth, comforting sweetness, the easygoing one of the whole bunch. Round, mellow, and perfectly content to just be a snack.
	}

	GreenHeart: {
		DisplayName: Green Heart
		Tooltip: ""
		Lore: A simple verdant heart bursting with raw, slightly feral chlorophyll. It beats in time with the forest's lifeblood, plugged directly into the woods. Fresh, vivid, and greener than it strictly needs to be.
	}

	LemonHeart: {
		DisplayName: Lemon Heart
		Tooltip: ""
		Lore: A bright yellow, shockingly sour heart. Its acidic punch snaps the mind awake and invigorates the body.
	}

	LimeHeart: {
		DisplayName: Lime Heart
		Tooltip: ""
		Lore: A zesty, green citrus heart with a sharp and refreshing tang. It cuts through fatigue like a swift blade.
	}

	MangoHeart: {
		DisplayName: Mango Heart
		Tooltip: ""
		Lore: A soft, incredibly sweet heart that tastes of a tropical paradise. It floods the veins with warm, syrupy life force.
	}

	MoonglowHeart: {
		DisplayName: Moonglow Heart
		Tooltip: ""
		Lore: A serene, glowing heart that blossoms under the starry night sky. It provides a calm, mystical vitality drawn from moonlight.
	}

	OrangeHeart: {
		DisplayName: Orange Heart
		Tooltip: ""
		Lore: A bright, cheerful heart bursting with sweet citrus juice. It delivers a sunny and uplifting surge of natural energy.
	}

	PeachHeart: {
		DisplayName: Peach Heart
		Tooltip: ""
		Lore: A soft, velvety heart with a sweet and fragrant core. It soothes the soul while mending the body.
	}

	PineappleHeart: {
		DisplayName: Pineapple Heart
		Tooltip: ""
		Lore: A spiky, tough heart that yields a powerfully tart and sweet vitality. It embodies the resilient spirit of tropical islands.
	}

	PlumHeart: {
		DisplayName: Plum Heart
		Tooltip: ""
		Lore: A smooth, dark purple heart with a deeply sweet and slightly tart flavor. It provides a rich, comforting burst of health.
	}

	PomegranateHeart: {
		DisplayName: Pomegranate Heart
		Tooltip: ""
		Lore: A tough heart filled with jewel-like, crimson seeds. Each seed bursts with a fierce, concentrated vitality.
	}

	RambutanHeart: {
		DisplayName: Rambutan Heart
		Tooltip: ""
		Lore: A strange, hairy heart that hides a pale, sweet interior. It offers an exotic and surprisingly refreshing surge of life.
	}

	ShiverthornHeart: {
		DisplayName: Shiverthorn Heart
		Tooltip: ""
		Lore: A freezing, frosty heart that chills the blood. It offers a crisp, biting vitality born of the unforgiving tundra.
	}

	StarFruitHeart: {
		DisplayName: Star Fruit Heart
		Tooltip: ""
		Lore: A celestial, yellow heart that tastes of shooting stars. It fills the bearer with the boundless energy of the cosmos.
	}

	TealHeart: {
		DisplayName: Teal Heart
		Tooltip: ""
		Lore: A peculiarly colored heart that hums with an enigmatic frequency. It grants a steady, stabilizing flow of strange energy.
	}

	ViciousMushroomHeart: {
		DisplayName: Vicious Mushroom Heart
		Tooltip: ""
		Lore: A grotesque, blood-red heart reeking of the Crimson's rot. It fuels the body with an aggressive, flesh-warping vitality.
	}

	VileMushroomHeart: {
		DisplayName: Vile Mushroom Heart
		Tooltip: ""
		Lore: A sickening, purple-tinged heart corrupted by the spores of the Corruption. It grants life through a dark, decaying resonance.
	}

	WaterleafHeart: {
		DisplayName: Waterleaf Heart
		Tooltip: ""
		Lore: A fragile, aquatic heart that blooms with renewed vitality when touched by rain. It pulses with the refreshing essence of a desert oasis.
	}

	VitalSoilItem: {
		DisplayName: Vital Soil
		Tooltip:
			'''
			Faintly glowing, life-aspected silt
			Spreads slowly to nearby Dirt, Mud, and Silt
			Can be crushed in the Extractinator
			Standing on it boosts life regeneration
			'''
	}

	VitalQuartzItem: {
		DisplayName: Vital Quartz
		Tooltip:
			'''
			Living stone shot through with peach and lime green
			Spreads slowly to nearby Stone
			Can be crushed in the Extractinator
			Grants extra maximum life while you are nearby
			'''
	}

	VitalChestItem: {
		DisplayName: Vital Chest
		Tooltip: ""
	}

	LifeFruitSeedItem: {
		DisplayName: Life Fruit Seed
		Tooltip: Plant on Vital Soil to grow a Life Fruit
	}

	LifeCrystalSeedItem: {
		DisplayName: Life Crystal Seed
		Tooltip: Plant on Vital Quartz to grow a Life Crystal
	}

	CommonLifeShardItem: {
		DisplayName: Common Life Shard Item
		Tooltip: ""
	}

	EnduranceHeart: {
		DisplayName: Endurance Heart
		Tooltip: ""
		Lore: Forged from the unyielding stone of the caverns, this heart grants its bearer the resilience to withstand even the most crushing blows. It beats with a slow, steady, and unbreakable rhythm.
	}

	LifeforceHeart: {
		DisplayName: Lifeforce Heart
		Tooltip: ""
		Lore: Overflowing with raw, untamed vitality, this vibrant heart expands your mortal limits. It pushes the boundaries of your being beyond what was thought possible.
	}

	LoveHeart: {
		DisplayName: Love Heart
		Tooltip: ""
		Lore: Radiating a warm, comforting glow, this tender heart leaves a trail of affection in its wake. It is said to soothe even the most savage beasts of the Blood Moon.
	}

	StinkHeart: {
		DisplayName: Stink Heart
		Tooltip: ""
		Lore: Reeking of decay and swamp gas, this foul heart repulses almost every living creature. It guarantees a solitary, undisturbed journey through the wilds.
	}

	AmmoReservationHeart: {
		DisplayName: Ammo Reservation Heart
		Tooltip: ""
		Lore: Infused with the hunter's conservation instinct. It makes every heartbeat, and every shot, count.
	}

	DangersenseHeart: {
		DisplayName: Dangersense Heart
		Tooltip: ""
		Lore: Twitching with a hyper-aware paranoia. It heightens the instincts to detect unseen traps and perils.
	}

	GravitationHeart: {
		DisplayName: Gravitation Heart
		Tooltip: ""
		Lore: A chaotic core that occasionally beats in reverse, distorting the very fabric of space around it. To hold it is to feel the sky beckoning you upward.
	}

	InfernoHeart: {
		DisplayName: Inferno Heart
		Tooltip: ""
		Lore: Blazing with the trapped heat of the Underworld, this heart scorches anything that dares approach. It is a terrifying testament to the power of pure, unbridled flame.
	}

	ObsidianSkinHeart: {
		DisplayName: Obsidian Skin Heart
		Tooltip: ""
		Lore: Coated in the hardened ash of Hellstone, this pitch-black heart scoffs at lava and flame. It provides safe passage through the searing lakes of the Underworld.
	}

	RageHeart: {
		DisplayName: Rage Heart
		Tooltip: ""
		Lore: Boiling with crimson fury, this heart demands blood and vengeance. It fills your strikes with a devastating, untamed power.
	}

	SummoningHeart: {
		DisplayName: Summoning Heart
		Tooltip: ""
		Lore: Echoing with the whispers of forgotten realms, this heart strengthens your bond with spectral minions. It commands the loyalty of otherworldly guardians.
	}

	WarmthHeart: {
		DisplayName: Warmth Heart
		Tooltip: ""
		Lore: Glowing like a hearth in a snowstorm, this heart shields its bearer from the biting frost. It melts the icy grip of the Snow biome's harshest blizzards.
	}

	WaterWalkingHeart: {
		DisplayName: Water Walking Heart
		Tooltip: ""
		Lore: Floating lightly upon the surface, this buoyant heart grants dominion over the waves. It allows you to tread upon water and molten lava alike.
	}

	WrathHeart: {
		DisplayName: Wrath Heart
		Tooltip: ""
		Lore: Seething with corrupted spite, this dark heart infuses your attacks with cruel precision. It demands the total annihilation of your enemies.
	}

	ArcheryHeart: {
		DisplayName: Archery Heart
		Tooltip: ""
		Lore: Taut with the tension of a drawn bowstring. It sharpens focus and enhances the archer's steady hand.
	}

	BattleHeart: {
		DisplayName: Battle Heart
		Tooltip: ""
		Lore: Beating with the frenzied drums of endless war. It draws enemies near and revels in the thrill of combat.
	}

	BiomeSightHeart: {
		DisplayName: Biome Sight Heart
		Tooltip: ""
		Lore: Radiating a perceptive energy that highlights the corruption and purity of the land. It attunes the senses to the world's hidden ailments.
	}

	BuilderHeart: {
		DisplayName: Builder Heart
		Tooltip: ""
		Lore: Structured and precise, humming with the rhythm of creation. It grants the endless stamina needed to shape the world.
	}

	CalmingHeart: {
		DisplayName: Calming Heart
		Tooltip: ""
		Lore: Emanating a soothing aura that quiets the surrounding chaos. It brings peace to the mind and safety from wandering monsters.
	}

	CrateHeart: {
		DisplayName: Crate Heart
		Tooltip: ""
		Lore: Filled with the hopeful anticipation of a grand catch. It brings the lucky vitality of a master angler.
	}

	FeatherfallHeart: {
		DisplayName: Featherfall Heart
		Tooltip: ""
		Lore: Woven from the down of a Harpy's wings, this weightless heart catches the wind itself. It whispers of gentle descents and skies untamed.
	}

	FishingHeart: {
		DisplayName: Fishing Heart
		Tooltip: ""
		Lore: A soggy, rhythmic organ said to belong to a legendary angler of the deep. It thrums with the tug of an unseen line, drawing the ocean's bounty to you.
	}

	FlipperHeart: {
		DisplayName: Flipper Heart
		Tooltip: ""
		Lore: Sleek and perpetually moist, this aquatic heart propels you effortlessly through the darkest waters. It carries the swift grace of the ocean's predators.
	}

	GillsHeart: {
		DisplayName: Gills Heart
		Tooltip: ""
		Lore: Laced with delicate aquatic membranes, this heart draws breath where there is no air. It beats in harmony with the gentle currents of the deep sea.
	}

	HeartreachHeart: {
		DisplayName: Heartreach Heart
		Tooltip: ""
		Lore: Pulsating with an irresistible magnetic charm, this heart hungers for vitality. It pulls the life force of fallen foes directly into your grasp.
	}

	HunterHeart: {
		DisplayName: Hunter Heart
		Tooltip: ""
		Lore: A primal organ that hums with the predatory instinct of the wild. It illuminates the unseen, making prey out of those who hide in the shadows.
	}

	IronskinHeart: {
		DisplayName: Ironskin Heart
		Tooltip: ""
		Lore: Hardened in the molten depths and tempered in battle, this metallic heart offers absolute defense. It clinks like heavy armor with every single beat.
	}

	MagicPowerHeart: {
		DisplayName: Magic Power Heart
		Tooltip: ""
		Lore: Crackling with arcane energy, this crystalline heart fuels the darkest and brightest of spells. It is a conduit for the pure essence of mana.
	}

	ManaRegenerationHeart: {
		DisplayName: Mana Regeneration Heart
		Tooltip: ""
		Lore: A shimmering, starry heart that constantly replenishes its own arcane reserves. It weaves fallen stars into an endless cycle of magical restoration.
	}

	MiningHeart: {
		DisplayName: Mining Heart
		Tooltip: ""
		Lore: Dusted with glittering ores, this industrious heart accelerates your hands and tools. It resonates with the deepest, richest veins of the earth.
	}

	NightOwlHeart: {
		DisplayName: Night Owl Heart
		Tooltip: ""
		Lore: Bathed in nocturnal magic, this watchful heart pierces the thickest gloom of the underground. It grants the unparalleled vision of a predator in the dark.
	}

	RegenerationHeart: {
		DisplayName: Regeneration Heart
		Tooltip: ""
		Lore: Beating with a soothing, mending rhythm, this heart knits flesh and bone back together. It embodies the persistent will to survive.
	}

	ShineHeart: {
		DisplayName: Shine Heart
		Tooltip: ""
		Lore: Radiating a brilliant, permanent aura, this luminous heart acts as a beacon in the abyss. It scatters the shadows of the deepest caverns.
	}

	SonarHeart: {
		DisplayName: Sonar Heart
		Tooltip: ""
		Lore: Rippling with echolocative magic, this heart detects the secrets hiding beneath the water's surface. It knows the exact shape of what lingers on your line.
	}

	SpelunkerHeart: {
		DisplayName: Spelunker Heart
		Tooltip: ""
		Lore: Embedded with microscopic gemstones, this attuned heart reacts to the presence of hidden wealth. It illuminates the earth's buried treasures like stars in the night.
	}

	SwiftnessHeart: {
		DisplayName: Swiftness Heart
		Tooltip: ""
		Lore: Vibrating with kinetic energy, this restless heart makes your feet as light as air. It races with the speed of a desert gale.
	}

	ThornsHeart: {
		DisplayName: Thorns Heart
		Tooltip: ""
		Lore: Wrapped in wicked, jagged briars, this spiteful heart violently reflects any pain inflicted upon it. It promises swift retribution to all attackers.
	}

	TitanHeart: {
		DisplayName: Titan Heart
		Tooltip: ""
		Lore: A massive, heavy heart that grants unparalleled physical dominance over your foes. It hits with the immovable force of a falling meteor.
	}

	MagnificationHeart: {
		DisplayName: Magnification Heart
		Tooltip: Permanently upgrades your camera
		Lore: An unusual crystalline organ that bends light and perception. It sharpens the senses to an almost unnatural degree.
	}

	JackOLanternHeart: {
		DisplayName: Jack-O'-Lantern Heart
		Tooltip: Permanently upgrades your dash
		Lore: Glowing with a haunting, spectral fire from the Pumpkin Moon. It fills its bearer with a mischievous, fiery vigor.
	}

	PiggyBankHeart: {
		DisplayName: Piggy Bank Heart
		Tooltip: Unlocks passive income: cash your banked Life Shards out as coins
		Lore: A plump porcelain heart that never stops jingling. It whispers of compound interest and the quiet joy of money made while you sleep.
	}

	LuckHeart: {
		Tooltip: ""
		DisplayName: Luck Heart
		Lore: Gleaming with an unpredictable sparkle, this golden core tilts the scales of fate in your favor. It turns mere chance into undeniable destiny.
	}

	InvisibilityHeart: {
		Tooltip: ""
		DisplayName: Invisibility Heart
		Lore: An ethereal, translucent core that barely casts a shadow. It fades from sight, hiding its bearer from the cruel gaze of the world.
	}

	TheTwinsHeart: {
		Tooltip: ""
		DisplayName: The Twins Heart
		Lore: A dual-chambered organ bound by optic nerves and lasers. It courses with a chaotic, divided energy.
	}

	TheDestroyerHeart: {
		Tooltip: ""
		DisplayName: The Destroyer Heart
		Lore: A massive, metallic core built to eradicate all life. It reinforces the flesh with cold, unyielding iron.
	}

	SkeletronPrimeHeart: {
		Tooltip: ""
		DisplayName: Skeletron Prime Heart
		Lore: A mechanical monstrosity of gears and dark magic. It pumps with the terrifying precision of a metal nightmare.
	}

	ClayHeart: {
		Tooltip: ""
		DisplayName: Clay Heart
		Lore: Molded from the damp earth, it beats with a sluggish but enduring resilience. A sturdy reminder of the world's ancient foundations.
	}

	ChestHeart: {
		Tooltip: Permanently unlocks 10 extra inventory slots
		DisplayName: Chest Heart
		Lore: A heavy, brass-bound heart that hums with the spacious energy of a storage chest.
	}

	MenacingHeartItem.Lore: A pulsating core radiating an intimidating aura, forged in the depths of adversity. It beats with the unyielding strength of a true warrior.
	CrossModHeartItem.Lore: An anomalous crystal formed where different realities intersect. It thrums with the combined energies of foreign realms.
	CalamityBossHeartItem.Lore: A triumphant trophy claimed from a supreme entity of destruction. Its immense power threatens to overwhelm the weak of mind.
	CalamityHeartItem.Lore: An ominous remnant overflowing with malevolent energy. It beats to the chaotic rhythm of an approaching disaster.
	ConsolariaBossHeartItem.Lore: A massive, imposing heart pulsating with the dominant aura of legendary titans. It beats with a terrifying power that commands respect from all who behold it.
	ConsolariaHeartItem.Lore: A nostalgic artifact, humming with the forgotten energies of a time long past. It contains a familiar warmth that resonates with seasoned adventurers.
	ThoriumBossHeartItem.Lore: A colossal, pulsating artifact forged from the combined might of epic conquerors. It radiates a legendary aura of immense, undeniable strength.
	ThoriumHeartItem.Lore: A refined piece of thorium, shaped into a core of potent, steady vitality. It hums with an industrialized, yet deeply magical, energy.
	BossHeartItem.Lore: A formidable heart harvested from a fallen titan, still echoing with its terrifying roar. It grants a fraction of the immense power once wielded by a true monster.
	ElementalHeartItem.Lore: A chaotic coalescence of fire, water, earth, and air, beating in perfect, violent harmony. It pulses with the raw, untamed fury of the primal elements.
	PotionHeartItem.Lore: A fragile, glass-like heart brimming with volatile, alchemical liquids. It bubbles and froths with the strange, synthesized vitality of countless concoctions.
}

