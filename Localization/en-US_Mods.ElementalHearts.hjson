# BossChecklist integration: spawn / despawn strings shown on each Animate
# boss's entry page. The [i:ItemInternalName] chat tag renders the spawn item's
# icon inline; "{0}" in despawn messages is replaced with the NPC's full name.
BossChecklist: {
	CommonAnimate: {
		SpawnInfo: Use a [i:ElementalHearts/CommonMenacingHeart] anywhere. Always craftable from a [i:LifeCrystal] at a Demon Altar.
		DespawnMessage: "{0} retreats into the dark, biding its time."
	}

	UncommonAnimate: {
		SpawnInfo: Use an [i:ElementalHearts/UncommonMenacingHeart] anywhere. Crafted from a [i:LifeCrystal] at a Demon Altar only after Common Animate has been defeated.
		DespawnMessage: "{0} fades from this world, its menace unanswered."
	}

	RareAnimate: {
		SpawnInfo: Use a [i:ElementalHearts/RareMenacingHeart] anywhere. Crafted from a [i:LifeCrystal] at a Demon Altar only after Uncommon Animate has been defeated.
		DespawnMessage: "{0} fades from this world, its menace unanswered."
	}

	EpicAnimate: {
		SpawnInfo: Use an [i:ElementalHearts/EpicMenacingHeart] anywhere. Crafted from a [i:LifeCrystal] at a Demon Altar only after Rare Animate has been defeated.
		DespawnMessage: "{0} fades from this world, its menace unanswered."
	}

	LegendaryAnimate: {
		SpawnInfo: Use a [i:ElementalHearts/LegendaryMenacingHeart] anywhere. Crafted from a [i:LifeCrystal] at a Demon Altar only after Epic Animate has been defeated.
		DespawnMessage: "{0} fades from this world, its menace unanswered."
	}
}

